---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Canvas from "../components/Canvas.astro";
import FlowSource from "../components/FlowSource.astro";
import RunTable from "../components/RunTable.astro";
import { checkCitations, sourceValidation, bestOfN } from "../lib/flows";

const steps = [
  {
    title: "Start from what you have.",
    body: "A draft report, a folder of documents, a list of URLs. You describe the job in plain terms and point the agent at the inputs.",
  },
  {
    title: "The agent drafts the flow.",
    body: "It can only place steps from the palette and wire them. If it tries to write a loop, read a file on the side or hard-code a value, the save is refused and the diagnostic names the construct.",
  },
  {
    title: "Read the canvas.",
    body: "Every card is a step and every wire carries one typed value. Rename a step, change a setting, delete one, or ask the agent for a change. You never need to open the source.",
  },
  {
    title: "Run it as a Test.",
    body: "Everything runs: the fetches, the model calls, the loops. Writes are held back and come back as dry-run receipts. When it looks right, escalate to a Run without redoing the work.",
  },
  {
    title: "Look at every row.",
    body: "Each step's outcome is listed, one per row inside a loop. A source that refused the fetch is a failed row with its cause. A step that never ran says so.",
  },
  {
    title: "Review where you choose.",
    body: "A Review card holds the run until a person answers, for a minute or a week. The decision is keyed to the inputs behind the output, so an approval cannot slide onto a different result.",
  },
  {
    title: "Run it again next week.",
    body: "Same flow, new inputs. A fix you made to one step is in the flow, not in your memory. When the flow starts to carry weight, pin the tables it reads and name who reviews it.",
  },
];

const reviewSource = `fn check_pair(pair: Row) -> Stance {
    let url   = Field::new(source_url).input(pair);
    let claim = Field::new(claim_text).input(pair);
    let page  = Source::new(fetch_source).input(url.text);
    let text  = Format::new(html_to_text).input(page.document);
    let st    = Judge::new(citation_stance).input(claim.text).context(text.text);
    let found = Check::new(quote_is_on_the_page).input(st.record);   // exact substring, or the row fails
    Stance { stance: st.record, verified: found.bool }
}

fn flow() {
    let draft   = Source::new(the_draft_report);
    let split   = Model::new(claims_and_sources).input(draft.document);
    let edited  = Review::new(fix_the_list).input(split.table);
    let checked = Map::new(each_pair).over(edited.table).map(check_pair);
    let ledger  = Aggregate::new(per_claim).input(checked.table);
    let saved   = Write::new(citation_ledger).input(ledger.table);
}`;
---

<BaseLayout
  title="How it works. Functionary"
  description="One job start to finish: an agent drafts the flow, you read the canvas, run it as a Test, inspect every row, review where you choose, and run it again next week."
>
  <section class="section first">
    <div class="container measure">
      <h1>How it works</h1>
      <p class="lead">
        Report QC, start to finish. A draft report goes in. Each claim is
        paired with its cited source, the source is fetched, a quote is pulled
        and checked against the page, and out comes a ledger of which claims
        hold. A person corrects the claim list before the checking starts.
      </p>
    </div>
    <div class="container wide canvas-wrap">
      <Canvas flow={checkCitations} bare />
      <p class="hero-cap">
        Dashed wires carry values a model wrote. The wire leaving the Check is
        verified: the quote is on the page, byte for byte. Hover a wire for
        its type.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <h2>{s.title}</h2>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="measure">
        <h2>The run record</h2>
        <p class="stack-p">
          A run pins what it will execute when it starts: the flow revision,
          every block version, the table revisions it reads. Each step's
          result is recorded against its path, one per row inside a loop. If
          the server dies halfway, the run resumes from its receipts and does
          not ask the model again.
        </p>
        <p>
          Results sit in run tables you can read and edit by hand. Committing
          one to the knowledge base makes an immutable revision, with every
          outcome it depends on pinned and marked partial if any cell failed.
        </p>
      </div>
      <div>
        <RunTable
          title="report-qc"
          subtitle="Run · Test"
          badge="outcomes"
          tint="var(--cat-synthesis)"
          columns={["path", "step", "status", "receipt"]}
          rows={[
            [{ text: "/map/0/stance" }, { text: "Judge" }, { text: "supports", origin: "generated" }, { text: "sha256:3c7e…" }],
            [{ text: "/map/0/quote" }, { text: "Check" }, { text: "verified", origin: "verified" }, { text: "sha256:b219…" }],
            [{ text: "/map/1/fetch" }, { text: "Source" }, { text: "", status: "failed" }, { text: "sha256:e04a…" }],
            [{ text: "/map/1/stance" }, { text: "Judge" }, { text: "did not run", origin: "computed" }, { text: "" }],
            [{ text: "/map/2/quote" }, { text: "Check" }, { text: "", status: "missing" }, { text: "sha256:9d10…" }],
            [{ text: "/write" }, { text: "Write" }, { text: "dry run", origin: "verified" }, { text: "sha256:51f2…" }],
          ]}
          caption="Outcomes by occurrence path from a Test. Pair 1's source refused the fetch, so its stance did not run. Pair 2's quote was not on the page, so the Check failed the row."
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="measure">
        <h2>The source</h2>
        <p class="stack-p">
          The agent wrote this. Each binding is a card, each argument a wire,
          and the function the Map calls is the body of its region. Nothing is
          in the file that is not on the canvas, and nothing is on the canvas
          that is not in the file.
        </p>
        <p>
          An agent can draft and Test a flow in your name. By default it
          cannot Run one, and it never approves on your behalf.
        </p>
      </div>
      <div>
        <FlowSource code={reviewSource} file="report-qc.rs" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="measure">
        <h2>Procedures</h2>
        <p class="stack-p">
          Some shapes come up in every job: best of N, adversarial review,
          consolidating duplicates, classify and route, recover from failure.
          Each is one item in the palette that expands on the canvas into
          visible steps, each with its own settings and its own receipt.
        </p>
      </div>
      <div class="procs">
        <Canvas
          flow={sourceValidation}
          legend
          caption="Source Validation. Search finds candidates; each is fetched, quoted against the criteria and graded; a Filter keeps what passes; a person samples the result."
        />
        <Canvas
          flow={bestOfN}
          legend
          caption="Best of N. Three drafts from three models, one chosen with a stated reason, one editor."
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container measure">
      <Button href="/self-hosting" variant="ghost">Deployment</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .first {
    border-top: none;
  }
  h1 {
    max-width: 22ch;
  }
  .lead {
    margin-top: var(--s-24);
  }
  .canvas-wrap {
    margin-top: var(--s-40);
  }
  .hero-cap {
    margin-top: var(--s-12);
    font-size: var(--ms-small);
    color: var(--fg-2);
    max-width: var(--measure-prose);
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: grid;
    gap: var(--s-32);
    max-width: var(--measure-prose);
  }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 3ch 1fr;
    column-gap: var(--s-16);
  }
  .steps li::before {
    content: counter(step);
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    color: var(--fg-3);
    padding-top: 0.35em;
  }
  .steps h2 {
    grid-column: 2;
    max-width: none;
  }
  .steps p {
    grid-column: 2;
    margin-top: var(--s-8);
  }

  h2 {
    max-width: 24ch;
  }
  .stack-p {
    margin-bottom: var(--s-16);
  }
  .section p {
    margin-top: var(--s-16);
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--s-40);
    align-items: start;
  }
  .split > div {
    min-width: 0;
  }
  .procs {
    margin-top: var(--s-40);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-40);
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
