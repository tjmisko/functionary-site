---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Canvas from "../components/Canvas.astro";
import FlowSource from "../components/FlowSource.astro";
import RunTable from "../components/RunTable.astro";
import { siteScan, checkCitations, bestOfN } from "../lib/flows";

const steps = [
  {
    title: "Start from what you have.",
    body: "A list of URLs in a table, a folder of documents, a file. There is no blank canvas to fill. You describe the job in plain terms to the agent and point it at the inputs.",
  },
  {
    title: "The agent drafts the flow.",
    body: "It can only place steps from the catalog and wire them. It cannot write a loop, read a file on the side, or hard-code a value. If it tries, the save is refused with a diagnostic naming the construct, and the canvas keeps the last accepted flow.",
  },
  {
    title: "Read the canvas.",
    body: "Every card is a step and every wire carries one typed value. The canvas is derived from the source, so what you see is the program. You rename a step, change a setting, delete one, or ask the agent for a change. You never need to open the source.",
  },
  {
    title: "Run it as a Test.",
    body: "Everything runs: the fetches, the model calls, the loops. The writes are withheld and come back as dry-run receipts. When the Test looks right, you escalate it to a Run without repeating the work.",
  },
  {
    title: "Look at every row.",
    body: "The run inspector lists each step's outcome, one per occurrence inside a loop. A page that refused the fetch is a failed row with its cause. A step that never ran says it did not run. Nothing is dropped to make the table look clean.",
  },
  {
    title: "Review where you choose.",
    body: "A Review card holds the run until a person answers. The run parks durably, for a minute or a week, and nothing else moves until the answer comes. The decision is a receipt, keyed to the inputs behind the output, so an approval cannot slide onto a different result.",
  },
  {
    title: "Run it again next week.",
    body: "Same flow, new inputs. A fix you made to one step is in the flow, not in your memory. When the flow starts to carry weight, pin the tables it reads and name who reviews it.",
  },
];

const reviewSource = `fn flow() {
    let draft = Summarize::new(one_digest).input(report.text);
    // Execution parks here until a person answers. The answer is a receipt.
    let read  = Review::new(before_it_goes_out).input(draft.text);
    let saved = Write::new(weekly_scan).input(read.text);
}`;
---

<BaseLayout
  title="How it works. Functionary"
  description="One job end to end: an agent drafts a flow of trusted steps, you read the canvas, run it as a Test, inspect every row, review where you choose, and run it again."
>
  <section class="section first">
    <div class="container measure">
      <h1>One job, end to end.</h1>
      <p class="lead">
        A weekly scan of a list of sites: fetch each page, summarize what
        changed, roll the summaries into one digest, have a person read it,
        write it down. Small enough to follow, and it runs today.
      </p>
    </div>
    <div class="container wide canvas-wrap">
      <Canvas flow={siteScan} status="built" caption="Nine steps. One loop. One person." />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <h2>{s.title}</h2>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="measure">
        <h2>What a run leaves behind.</h2>
        <p class="stack-p">
          A run pins what it will execute when it starts: the flow revision,
          every block version, the table revisions it reads. Each step's
          result is recorded against its path, so a step inside a loop has one
          result per row. If the server dies halfway, the run resumes from its
          receipts and does not ask the model again.
        </p>
        <p>
          Results sit in run tables you can read. Committing one to the
          knowledge base makes an immutable revision that outlives the run,
          with every outcome it depends on pinned, and marked partial if any
          cell failed.
        </p>
      </div>
      <div>
        <RunTable
          columns={["path", "step", "status", "receipt"]}
          mono={[0, 3]}
          rows={[
            [{ text: "/map/0/issues" }, { text: "Summarize" }, { text: "complete", origin: "generated" }, { text: "sha256:3c7e…" }],
            [{ text: "/map/1/issues" }, { text: "Summarize" }, { text: "complete", origin: "generated" }, { text: "sha256:b219…" }],
            [{ text: "/map/2/fetch" }, { text: "Source" }, { text: "", status: "failed" }, { text: "sha256:e04a…" }],
            [{ text: "/map/2/issues" }, { text: "Summarize" }, { text: "did not run", origin: "computed" }, { text: "" }],
            [{ text: "/review" }, { text: "Review" }, { text: "approved", origin: "reviewed" }, { text: "sha256:9d10…" }],
            [{ text: "/write" }, { text: "Write" }, { text: "dry run", origin: "reviewed" }, { text: "sha256:51f2…" }],
          ]}
          caption="Outcomes by occurrence path from a Test. Row 2's fetch failed, so its summary did not run; the Write was withheld."
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="measure">
        <h2>A person is a step.</h2>
        <p class="stack-p">
          Review is a gate on the canvas like any other card. It takes a value
          and either lets it through or stops it, and the flow cannot invent
          the missing answer. You put one where the judgement is yours: before
          a write leaves the machine, on a sample of merged records, on a
          claim the model graded low.
        </p>
        <p>
          An agent can draft and Test a flow in your name. By default it
          cannot Run one, and it never approves on your behalf.
        </p>
      </div>
      <div>
        <FlowSource code={reviewSource} file="weekly-scan.rs" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="measure">
        <h2>Where this is going.</h2>
        <p class="stack-p">
          The block ontology decided on 29 October 2026 adds the steps that
          carry the contamination argument all the way through: origin on
          every wire, Check as a deterministic gate, Quote and Model as the
          blocks that harvest from sources with an anchor back to the exact
          passage, and named compositions you insert as one step. Two of them,
          drawn as designed.
        </p>
      </div>
      <div class="designed">
        <Canvas
          flow={checkCitations}
          legend
          status="designed"
          caption="Check the citations in a pasted answer. Each quote is verified as a substring of the page it came from; the knowledge base will refuse anything that is not."
        />
        <Canvas
          flow={bestOfN}
          legend
          status="designed"
          caption="Best of N. Three drafts from different models, one chosen with a stated reason, one editor."
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container measure">
      <Button href="/self-hosting" variant="ghost">Deployment</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .first {
    border-top: none;
  }
  h1 {
    max-width: 22ch;
  }
  .lead {
    margin-top: var(--s-24);
  }
  .canvas-wrap {
    margin-top: var(--s-40);
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: grid;
    gap: var(--s-32);
    max-width: var(--measure-prose);
  }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 3ch 1fr;
    column-gap: var(--s-16);
  }
  .steps li::before {
    content: counter(step);
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    color: var(--fg-3);
    padding-top: 0.35em;
  }
  .steps h2 {
    grid-column: 2;
    max-width: none;
  }
  .steps p {
    grid-column: 2;
    margin-top: var(--s-8);
  }

  h2 {
    max-width: 24ch;
  }
  .stack-p {
    margin-bottom: var(--s-16);
  }
  .section p {
    margin-top: var(--s-16);
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--s-40);
    align-items: start;
  }
  .designed {
    margin-top: var(--s-40);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-40);
  }
  .split > div {
    min-width: 0;
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
