---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Pillar from "../components/Pillar.astro";
import FlowSnippet from "../components/FlowSnippet.astro";
import { type BlockCategory } from "../lib/flow";

const pillars = [
  {
    eyebrow: "Visible",
    title: "See the work take shape",
    body: "The Project Agent works on the same canvas you do. Sketches, typed blocks, connections, and revisions remain visible while a fuzzy request becomes an executable process.",
  },
  {
    eyebrow: "Bounded",
    title: "Put discretion in its place",
    body: "A Sketch may begin with open-ended agent work. Tool ceilings, declared effects, human pauses, and Test mode make that discretion visible and constrain what it can change.",
  },
  {
    eyebrow: "Auditable",
    title: "Turn runs into evidence",
    body: "Captured runs record inputs, outputs, configuration, model activity, and execution lineage. Extraction blocks can also attach the passages behind structured findings.",
  },
];

const verifyFlow: { label: string; category: BlockCategory }[] = [
  { label: "Agent Sketch", category: "extraction" },
  { label: "Test Runs", category: "control" },
  { label: "Typed Flow", category: "transformation" },
];

const sectors = [
  ["Research and analysis", "Monitor sources, extract findings, compare evidence, draft recurring briefs."],
  ["Customer operations", "Reconcile feedback, classify intake, route exceptions, prepare responses."],
  ["Internal operations", "Triage files, assemble reports, coordinate reviews, publish artifacts."],
  ["Project teams", "Turn a shared body of knowledge into repeatable, observable work."],
  ["Process owners", "Start from the desired outcome and formalize the reliable parts as they emerge."],
  ["Technical operations", "Combine typed blocks, reusable modules, connectors, and explicit human pauses."],
];

const notList = [
  ["Not an invisible general-purpose agent", "Discretion has a visible place in the flow, explicit instructions, and a path toward tighter constraints."],
  ["Not one-click certainty", "A useful first run is the beginning. Reliability comes from testing, observing, and formalizing what works."],
  ["Not a low-code app builder", "Functionary builds automation flows, not user-facing applications."],
  ["Not your external system of record", "It still persists flows, run state, artifacts, and project knowledge needed to do the work."],
  ["Not a replacement for judgment", "It routes judgment to the right person at the right time."],
];
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <Eyebrow>Automation for knowledge work</Eyebrow>
      <h1 class="display">
        Turn fuzzy recurring work into a process you can see become reliable.
      </h1>
      <p class="lead measure">
        Describe the outcome inside a project. The Project Agent sketches the
        work on a visible canvas, runs it safely in Test, and records what
        happened. Keep the discretionary parts that help; replace the repeated,
        reliable parts with typed blocks, policies, and deliberate human review.
      </p>
      <div class="actions">
        <Button href="/how-it-works" variant="primary">See how it works</Button>
        <Button href="/self-hosting" variant="ghost">Deployment posture</Button>
      </div>
    </div>
    <div class="container hero-canvas">
      <Hero />
      <p class="desktop-note">A desktop canvas — best explored on a big screen.</p>
    </div>
  </section>

  <!-- THE GAP -->
  <section class="section">
    <div class="container measure">
      <Eyebrow>Start with the work as it is</Eyebrow>
      <h2>Freestyle is the on-ramp, not the destination.</h2>
      <p class="stack-p">
        Most useful processes do not arrive fully specified. You know the shape
        of the result before you know every step. A Sketch gives the agent room
        to produce that first result while Functionary captures the prompt,
        tools, inputs, outputs, and decisions that made it possible.
      </p>
      <p>
        Those captured runs are evidence. Watch what repeats, add the constraints
        the agent needed, and graduate stable work into blocks with declared
        inputs, outputs, effects, and discretion. Trust grows by removing
        dependence on in-the-moment choices where the evidence says you can.
      </p>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="section">
    <div class="container">
      <Eyebrow>Visible · Bounded · Auditable</Eyebrow>
      <h2>Built around what automation gets dangerously wrong, quietly.</h2>
      <div class="grid-3">
        {pillars.map((p) => <Pillar eyebrow={p.eyebrow} title={p.title}>{p.body}</Pillar>)}
      </div>
    </div>
  </section>

  <!-- SKETCH, TEST, GRADUATE -->
  <section class="section">
    <div class="container split">
      <div class="measure">
        <Eyebrow>Sketch · Test · Graduate</Eyebrow>
        <h2>The agent works in the process, and helps make the process better.</h2>
        <p class="stack-p">
          The Project Agent can create canvas state, connect blocks, use project
          knowledge, and Test the result while you watch. Where the process is
          still unclear, an executable Sketch can do the work with declared
          instructions and tool ceilings. Where the process is understood, use
          narrower typed blocks.
        </p>
        <p class="stack-p">
          You rarely know the exact process up front, but you know useful work
          when you see it. The canvas makes that reactive loop durable: ask,
          watch, correct, and keep the result as project state rather than a
          private prompt habit. Runs and transcripts remain available as
          evidence for the next refinement.
        </p>
        <p class="stack-p">
          Test mode lets you exercise representative inputs without committing
          external writes. Review each step according to its declared
          determinism and discretion. When the evidence supports it, narrow the
          Sketch, add a validator, insert a human pause, or replace agent work
          with a deterministic implementation.
        </p>
        <p>
          Humans are first-class participants, not edge cases. Approval, manual
          input, inspection, and review stay explicit wherever accountability
          cannot be delegated.
        </p>
      </div>
      <div class="snippet-wrap">
        <FlowSnippet nodes={verifyFlow} caption="Repeated agent work can graduate into a narrower, typed flow." />
      </div>
    </div>
  </section>

  <!-- THE WEDGE -->
  <section class="section">
    <div class="container measure">
      <Eyebrow>What's different</Eyebrow>
      <h2>Plenty of tools draw the pipeline. Functionary shows the judgment inside it.</h2>
      <p class="stack-p">
        A visual canvas is table stakes — every automation tool has one, and
        they all show you the same thing: the plumbing, what connects to what.
        What they leave as a black box is the step where an agent made a call.
        Functionary gives discretion a visible place and captures what the run
        consumed, produced, and invoked. Extraction blocks can attach supporting
        passages to structured findings; every successful block records its
        execution lineage. The canvas becomes a place to improve the work, not
        only a wiring diagram.
      </p>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section class="section">
    <div class="container">
      <Eyebrow>Who it's for</Eyebrow>
      <h2>Start with recurring work whose shape is clearer than its implementation.</h2>
      <p class="measure stack-p">
        Functionary is for knowledge workers who can describe a useful outcome
        but should not need to specify a complete program before they begin.
        Start with an agent-backed sketch, learn from real Test runs, and invest
        in formalization only where the work repeats and the evidence warrants it.
      </p>
      <dl class="grid-3 sectors">
        {sectors.map(([term, desc]) => (
          <div class="sector">
            <dt>{term}</dt>
            <dd>{desc}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- WHAT IT IS NOT -->
  <section class="section">
    <div class="container measure">
      <Eyebrow>What it is not</Eyebrow>
      <h2>It earns trust by refusing scope.</h2>
      <ul class="not-list">
        {notList.map(([term, desc]) => (
          <li>
            <span class="not-term">{term}.</span> {desc}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="container measure">
      <h2>Your process should outlive the prompt that started it.</h2>
      <p class="stack-p">
        Flows are readable JSON. Project state and execution history live under
        an operator-selected data root. Model providers and connectors are
        explicit choices, so you can decide where information is allowed to go.
      </p>
      <div class="actions">
        <Button href="/how-it-works" variant="primary">See how it works</Button>
        <Button href="/philosophy" variant="ghost">Read the philosophy</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3.5rem, 8vh, 6rem) var(--section-pad);
  }
  h1.display {
    margin-top: var(--s-16);
    max-width: 20ch;
    /* Long tokens (e.g. "by-the-book") must never push past the viewport on
       narrow phones — break + hyphenate before they overflow. */
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .lead {
    margin-top: var(--s-24);
  }
  /* Mobile-only: the product is a desktop canvas. Land the pitch, signal where
     it lives — not a funnel (DESIGN.md CTA stance). */
  .desktop-note {
    display: none;
    margin-top: var(--s-16);
    font-family: var(--font-mono);
    font-size: var(--ms-small);
    color: var(--fg-3);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-12);
    margin-top: var(--s-32);
  }
  .hero-canvas {
    margin-top: var(--s-40);
  }

  h2 {
    max-width: 22ch;
  }
  .stack-p {
    margin-bottom: var(--s-16);
  }
  .section p {
    margin-top: var(--s-16);
  }

  .grid-3 {
    margin-top: var(--s-40);
    display: grid;
    gap: var(--s-20);
    grid-template-columns: repeat(3, 1fr);
  }

  .split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--s-40);
    align-items: center;
  }
  .snippet-wrap {
    background: var(--bg-1);
    border: 1px solid var(--border-0);
    border-radius: var(--r-10);
    padding: var(--s-32) var(--s-24);
  }

  .sectors {
    margin-top: var(--s-32);
  }
  .sector dt {
    font-weight: 600;
    color: var(--fg-0);
  }
  .sector dd {
    margin: var(--s-4) 0 0;
    color: var(--fg-2);
    font-size: var(--ms-small);
  }

  .not-list {
    margin-top: var(--s-24);
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--s-16);
  }
  .not-list li {
    padding-left: var(--s-20);
    position: relative;
    color: var(--fg-2);
    font-size: var(--ms-small);
  }
  .not-list li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .not-term {
    color: var(--fg-0);
    font-weight: 600;
  }

  .cta {
    background: var(--bg-1);
  }

  @media (max-width: 860px) {
    .grid-3,
    .split {
      grid-template-columns: 1fr;
    }
    .desktop-note {
      display: block;
    }
  }

  /* Small phones: ease the display down a touch so the headline never right-cuts
     the lead and dots below it. */
  @media (max-width: 480px) {
    h1.display {
      font-size: clamp(2rem, 1rem + 6vw, 2.55rem);
    }
  }
</style>
