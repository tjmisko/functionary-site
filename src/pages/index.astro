---
/**
 * Home: one screen. The figure is the page: its graph-paper ground runs
 * edge to edge behind a pinned screen, the title sits on one line above the
 * drawing and the player under it. The scroll position steps the figure
 * through the phases of one example. The sections that explain the product
 * are on /design.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import FlowHero from "../components/figures/FlowHero.astro";
---

<BaseLayout>
  <section class="scrolly" data-hero-scroll>
    <div class="pin">
      <div class="hero-top">
        <h1 class="display">Agent Harness for Knowledge Work</h1>
      </div>
      <div class="hero-fig">
        <FlowHero />
      </div>
    </div>
  </section>

  <section class="next">
    <div class="container">
      <p class="lead">
        An agent writes the job as a program built from fixed blocks. A
        runtime executes it and records every run, so the work can be
        reproduced and checked.
      </p>
      <h2>Design</h2>
      <p>
        The program an agent writes, the run that executes it, the record a
        run leaves, and where it all runs.
      </p>
      <div class="actions">
        <Button href="/design" variant="primary">Design</Button>
        <Button href="/download" variant="ghost">Download</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* The canvas is full-bleed, so the header's ends follow the figure's rather than the reading width. */
  :root {
    --bar-w: calc(min(100vw - 3rem, (100vh - 57px - 6.5rem) * 1.93) + 3rem);
  }
  @media (max-width: 860px) {
    :root {
      --bar-w: 100vw;
    }
  }
</style>

<style>
  /* The page is tall; the figure stays put and the scroll moves its clock. */
  .scrolly {
    --header: 57px;
    /* About 18.5vh of scroll per second of the figure's clock (97.7 s). */
    height: 1807vh;
  }
  /* The pinned screen is the canvas: the figure's ground, edge to edge. */
  .pin {
    /* As wide as the window and the screen height allow, so the title, the drawing and the player share one screen. */
    --fig-w: min(calc(100vw - 3rem), calc((100vh - var(--header) - 6.5rem) * 1.93));
    position: sticky;
    top: var(--header);
    height: calc(100vh - var(--header));
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: color-mix(in srgb, var(--bg-0) 72%, #000);
    background-image:
      linear-gradient(var(--canvas-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--canvas-grid) 1px, transparent 1px);
    background-size: 20px 20px;
  }
  .hero-top {
    width: var(--fig-w);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-24);
  }
  h1.display {
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-12);
  }
  .hero-fig {
    margin-top: var(--s-8);
    width: var(--fig-w);
  }
  /* No box round the drawing here: the page is its ground. */
  .hero-fig :global(.plate .ground) {
    border: 0;
    border-radius: 0;
    background: none;
    padding: 0;
  }

  .next {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
    border-top: 1px solid var(--border-0);
  }
  .next .lead {
    max-width: 46rem;
    margin-bottom: var(--s-32);
  }
  .next p {
    margin-top: var(--s-16);
    max-width: var(--measure-prose);
  }
  .next .actions {
    margin-top: var(--s-24);
  }

  /* On a narrow screen the figure scrolls sideways, so it plays on its own. */
  @media (max-width: 860px) {
    .scrolly {
      height: auto;
    }
    .pin {
      --fig-w: calc(100vw - 2rem);
      position: static;
      height: auto;
      padding-block: var(--s-24);
    }
    .hero-top {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
