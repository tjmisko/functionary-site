---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Pillar from "../components/Pillar.astro";
import FlowSnippet from "../components/FlowSnippet.astro";
import { type BlockCategory } from "../lib/flow";

const pillars = [
  {
    eyebrow: "Visible",
    title: "See the work take shape",
    body: "The agent works on the same canvas you do. Sketches, typed blocks, connections, and revisions stay visible while a fuzzy request becomes an executable process.",
  },
  {
    eyebrow: "Bounded",
    title: "Put discretion in its place",
    body: "A sketch may begin as open-ended agent work. Tool ceilings, declared effects, human pauses, and Test mode make that discretion visible and limit what it can change.",
  },
  {
    eyebrow: "Auditable",
    title: "Turn runs into evidence",
    body: "Every run records inputs, outputs, configuration, model activity, and lineage. Extraction blocks attach the passages behind their findings.",
  },
];

const verifyFlow: { label: string; category: BlockCategory }[] = [
  { label: "Agent Sketch", category: "extraction" },
  { label: "Test Runs", category: "control" },
  { label: "Typed Flow", category: "transformation" },
];

const sectors = [
  ["Research and analysis", "Monitor sources, extract findings, compare evidence, draft recurring briefs."],
  ["Customer operations", "Reconcile feedback, classify intake, route exceptions, prepare responses."],
  ["Internal operations", "Triage files, assemble reports, coordinate reviews, publish artifacts."],
  ["Project teams", "Turn a shared body of knowledge into repeatable, observable work."],
  ["Process owners", "Start from the desired outcome and formalize the reliable parts as they emerge."],
  ["Technical operations", "Combine typed blocks, reusable modules, connectors, and explicit human pauses."],
];

---

<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <Eyebrow>Automation for Knowledge Work</Eyebrow>
      <h1 class="display">
        Process information with agents without handing agents control
        over the process.
      </h1>
      <p class="lead measure">
        Lay out a workflow on the canvas, starting from a loose
        sketch of the steps and iterating towards a detailed,
        repeatable, and defensible process. Delegate low-stakes 
        mechancial judgements to agents, drop-in adversarial 
        multi-agent review when needed, and add human review 
        gates for the most critical steps in the process.
      </p>
      <div class="actions">
        <Button href="/how-it-works" variant="primary">See how it works</Button>
        <Button href="/self-hosting" variant="ghost">Deployment</Button>
      </div>
    </div>
    <div class="container hero-canvas">
      <Hero />
      <p class="desktop-note">A desktop canvas — best explored on a big screen.</p>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="section">
    <div class="container">
      <Eyebrow>Visible · Bounded · Auditable</Eyebrow>
      <h2>Built around what automation gets wrong, quietly.</h2>
      <p class="measure stack-p">
        Every automation tool draws the plumbing. What they leave as a black box
        is the step where an agent made a call. Functionary shows the judgment
        inside the pipeline.
      </p>
      <div class="grid-3">
        {pillars.map((p) => <Pillar eyebrow={p.eyebrow} title={p.title}>{p.body}</Pillar>)}
      </div>
    </div>
  </section>

  <!-- SKETCH, TEST, GRADUATE -->
  <section class="section">
    <div class="container split">
      <div class="measure">
        <Eyebrow>Sketch · Test · Graduate</Eyebrow>
        <h2>Freestyle is the on-ramp, not the destination.</h2>
        <p class="stack-p">
          You rarely know the exact process up front, but you know useful work
          when you see it. A sketch gives the agent room to produce that first
          result while Functionary captures the prompt, tools, inputs, outputs,
          and decisions behind it. Those captured runs are evidence.
        </p>
        <p>
          Test mode exercises representative inputs without committing external
          writes. When the evidence supports it, narrow the sketch: add a
          schema, a validator, or a human pause, or replace agent work with a
          deterministic block. Trust grows by removing dependence on
          in-the-moment choices, not by banning the agent.
        </p>
      </div>
      <div class="snippet-wrap">
        <FlowSnippet nodes={verifyFlow} caption="Repeated agent work graduates into a narrower, typed flow." />
      </div>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section class="section">
    <div class="container">
      <Eyebrow>Who it's for</Eyebrow>
      <h2>Recurring work whose shape is clearer than its implementation.</h2>
      <p class="measure stack-p">
        For knowledge workers who can describe a useful outcome but should not
        have to specify a complete program before they begin.
      </p>
      <dl class="grid-3 sectors">
        {sectors.map(([term, desc]) => (
          <div class="sector">
            <dt>{term}</dt>
            <dd>{desc}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="container measure">
      <h2>Your process should outlive the prompt that started it.</h2>
      <p class="stack-p">
        Flows are readable JSON. Project state and run history live under a
        data root you choose. Model providers and connectors are explicit
        choices, so you decide where information goes.
      </p>
      <div class="actions">
        <Button href="/how-it-works" variant="primary">See how it works</Button>
        <Button href="/self-hosting" variant="ghost">Deployment posture</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3.5rem, 8vh, 6rem) var(--section-pad);
  }
  h1.display {
    margin-top: var(--s-16);
    max-width: 26ch;
    /* Break between words only — auto-hyphenation split "con-trol" across
       lines at desktop widths. Balance keeps the last line from orphaning. */
    hyphens: manual;
    overflow-wrap: normal;
    text-wrap: balance;
  }
  .lead {
    margin-top: var(--s-24);
  }
  /* Mobile-only: the product is a desktop canvas. Land the pitch, signal where
     it lives — not a funnel (DESIGN.md CTA stance). */
  .desktop-note {
    display: none;
    margin-top: var(--s-16);
    font-family: var(--font-mono);
    font-size: var(--ms-small);
    color: var(--fg-3);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-12);
    margin-top: var(--s-32);
  }
  .hero-canvas {
    margin-top: var(--s-40);
  }

  h2 {
    max-width: 22ch;
  }
  .stack-p {
    margin-bottom: var(--s-16);
  }
  .section p {
    margin-top: var(--s-16);
  }

  .grid-3 {
    margin-top: var(--s-40);
    display: grid;
    gap: var(--s-20);
    grid-template-columns: repeat(3, 1fr);
  }

  .split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--s-40);
    align-items: center;
  }
  .snippet-wrap {
    background: var(--bg-1);
    border: 1px solid var(--border-0);
    border-radius: var(--r-10);
    padding: var(--s-32) var(--s-24);
  }

  .sectors {
    margin-top: var(--s-32);
  }
  .sector dt {
    font-weight: 600;
    color: var(--fg-0);
  }
  .sector dd {
    margin: var(--s-4) 0 0;
    color: var(--fg-2);
    font-size: var(--ms-small);
  }


  .cta {
    background: var(--bg-1);
  }

  @media (max-width: 860px) {
    .grid-3,
    .split {
      grid-template-columns: 1fr;
    }
    .desktop-note {
      display: block;
    }
  }

  @media (max-width: 480px) {
    h1.display {
      font-size: clamp(2rem, 1rem + 6vw, 2.55rem);
    }
  }
</style>
