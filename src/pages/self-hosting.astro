---
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Pillar from "../components/Pillar.astro";
import CodeBlock from "../components/CodeBlock.astro";

const pillars = [
  {
    eyebrow: "Files",
    title: "Flows are files",
    body: "A flow is readable, pretty-printed JSON. Read it, diff it, commit it, and edit it outside the canvas without converting from a proprietary project format.",
  },
  {
    eyebrow: "State",
    title: "A data root you choose",
    body: "Flow files, artifacts, execution history, and other runtime state live beneath an operator-selected local data root, as JSON files and local databases.",
  },
  {
    eyebrow: "Egress",
    title: "Connections are choices",
    body: "Model providers and connectors determine what leaves the machine. Ollama provides a local inference path; remote models and external connectors transmit the inputs they need.",
  },
];
---

<BaseLayout
  title="Deployment — Functionary"
  description="Functionary keeps flows readable and runtime state under an operator-selected data root, with explicit choices for model and connector egress."
>
  <!-- HEADER -->
  <section class="section">
    <div class="container measure">
      <Eyebrow>Deployment</Eyebrow>
      <h1>Own the process. Choose the data boundary.</h1>
      <p class="lead measure">
        Functionary is built for operator-controlled deployment. Today the
        repository runs locally for development; a packaged self-hosting build
        and a hosted service are not yet available. The ownership model is
        already concrete: readable flow files and local runtime state.
      </p>
    </div>
  </section>

  <!-- IT'S JUST A FILE -->
  <section class="section">
    <div class="container measure">
      <Eyebrow>It's just a file</Eyebrow>
      <h2>A flow is readable JSON, not an opaque project format.</h2>
      <p class="stack-p">
        No vendor database holds your process. A flow is nodes and edges in
        pretty-printed JSON. Read it, diff it in review, commit it alongside the
        rest of your code, and edit it with ordinary file tools.
      </p>
      <CodeBlock file="flow.json">{`{
  "name": "Research brief",
  "version": "1.0.0",
  "nodes": [
    {
      "id": "regularize-1",
      "block_type": {
        "block_type": "regularize",
        "accepted_formats": ["pdf", "html", "txt"]
      },
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "extract-1",
      "block_type": {
        "block_type": "extract_insights",
        "topics": ["changes", "risks"]
      },
      "position": { "x": 240, "y": 0 }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "regularize-1",
      "target": "extract-1",
      "verified": true
    }
  ]
}`}</CodeBlock>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="section">
    <div class="container">
      <Eyebrow>Files · State · Egress</Eyebrow>
      <h2>Ownership is a property of the architecture, not a clause.</h2>
      <div class="grid-3">
        {pillars.map((p) => <Pillar eyebrow={p.eyebrow} title={p.title}>{p.body}</Pillar>)}
      </div>
    </div>
  </section>

  <!-- CONTROL BY DESIGN -->
  <section class="section">
    <div class="container measure">
      <Eyebrow>Control by design</Eyebrow>
      <h2>Local state does not mean no egress. The boundary is explicit.</h2>
      <p class="stack-p">
        Flow files and local databases stay on disk without a network, and
        telemetry export is off by default. A configured model provider or
        connector still uses the network. Choose Ollama or model-free blocks
        when inference must stay local; PII checks can block a step, and
        output policies can redact or hash matching fields.
      </p>
      <p>
        Connector credentials are encrypted at rest when a key management
        service is configured. Without one, the server warns at startup that
        credentials are stored in plaintext. Deployed builds require a local
        application account and session.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="container measure">
      <h2>Portability starts with a process you can read.</h2>
      <p class="stack-p">
        Flows live outside a proprietary project format, and runtime state
        stays under a path the operator selects. Distribution and licensing
        terms are still being settled and will land here when they are.
      </p>
      <div class="actions">
        <Button href="/how-it-works" variant="primary">See how it works</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    margin-top: var(--s-16);
    max-width: 22ch;
  }
  .lead {
    margin-top: var(--s-24);
  }
  h2 {
    max-width: 26ch;
  }
  .stack-p {
    margin-bottom: var(--s-16);
  }
  .section p {
    margin-top: var(--s-16);
  }

  .grid-3 {
    margin-top: var(--s-40);
    display: grid;
    gap: var(--s-20);
    grid-template-columns: repeat(3, 1fr);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-12);
    margin-top: var(--s-32);
  }

  .cta {
    background: var(--bg-1);
  }

  @media (max-width: 860px) {
    .grid-3 {
      grid-template-columns: 1fr;
    }
  }
</style>
