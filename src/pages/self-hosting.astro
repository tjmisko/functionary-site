---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";

const readers = [
  ["Mail and calendar", "Gmail, Outlook, IMAP, Google Calendar"],
  ["Files", "Google Drive, OneDrive"],
  ["Chat and meetings", "Slack, Teams, Zoom"],
  ["Project tools", "Jira, Asana, Linear, Notion"],
  ["CRM and finance", "Salesforce, HubSpot, Stripe, QuickBooks, DocuSign"],
  ["Databases", "Postgres, MySQL, Airtable"],
];
---

<BaseLayout
  title="Deployment. Functionary"
  description="Where Functionary runs, what leaves the machine, which systems it reads from, and how a personal or governed workspace is set up."
>
  <section class="section first">
    <div class="container measure">
      <h1>Deployment</h1>
      <p class="lead">
        Functionary runs on a machine you control. Flows, runs, receipts and
        results stay where you put them. Everything that leaves is a step you
        can see on the canvas.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container measure">
      <h2>Flows are source files</h2>
      <p class="stack-p">
        Each flow is one file, kept with its project. The canvas is drawn
        from it and edits are written back. Every save is a revision with a
        content hash, and a run binds to the exact revision it executed. You
        can read the file, but you never have to.
      </p>
      <p>
        Run history, receipts, run tables and the knowledge base live under one
        data directory.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container measure">
      <h2>What leaves the machine</h2>
      <p class="stack-p">
        Nothing leaves except through a step on the canvas. A Source fetches a
        URL or reads a connected system. A block calls the model you connected
        to it. A Write puts a value somewhere. Each is a card you can see
        before you run and a receipt after.
      </p>
      <p class="stack-p">
        Test holds back the writes. It does not hold back the reads or the
        model calls, because a dry run that skipped them would tell you
        nothing. A value labelled local is refused at any step that would send
        it to a remote model.
      </p>
      <p>
        Blocks run on one vetted model through a provider configured to retain
        nothing. Telemetry is off unless you configure an endpoint.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="measure">
        <h2>Connected systems</h2>
        <p class="stack-p">
          A Source reads from these systems. Each read is a step on the canvas
          with a receipt behind it.
        </p>
      </div>
      <dl class="readers">
        {readers.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container measure">
      <h2>Workspaces</h2>
      <p class="stack-p">
        A personal workspace is one person who creates, edits, runs and
        reviews, with no roles. A governed workspace names editors, runners,
        reviewers and administrators, decides whether agents may Run as well
        as Test, and can require an approved revision before an unattended
        run.
      </p>
      <p>
        Agents hold their own credentials. An agent never owns a flow, never
        deletes one, and never approves a revision.
      </p>
    </div>
  </section>

  <section class="section cta">
    <div class="container measure">
      <h2>Distribution</h2>
      <p class="stack-p">
        Distribution and licensing terms will be posted here when they are
        settled.
      </p>
      <div class="actions">
        <Button href="/how-it-works" variant="primary">Walkthrough</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .first {
    border-top: none;
  }
  h1 {
    max-width: 22ch;
  }
  .lead {
    margin-top: var(--s-24);
  }
  h2 {
    max-width: 26ch;
  }
  .stack-p {
    margin-bottom: var(--s-16);
  }
  .section p {
    margin-top: var(--s-16);
  }
  .readers {
    margin-top: var(--s-32);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-20);
  }
  .readers dt {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    font-weight: 700;
    color: var(--fg-0);
  }
  .readers dd {
    margin: var(--s-4) 0 0;
    color: var(--fg-2);
    font-size: var(--ms-small);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-12);
    margin-top: var(--s-32);
  }
  .cta {
    background: var(--bg-1);
  }
  @media (max-width: 860px) {
    .readers {
      grid-template-columns: 1fr;
    }
  }
</style>
