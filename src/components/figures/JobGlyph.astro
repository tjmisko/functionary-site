---
/** A small pictogram of each job's shape, for the job cards. */
interface Props {
  job: "qc" | "validate" | "dataset" | "evidence" | "market" | "revision";
}
const { job } = Astro.props;
const grid = Array.from({ length: 15 }, (_, i) => ({
  x: 22 + (i % 5) * 16,
  y: 8 + Math.floor(i / 5) * 12,
  on: [0, 1, 3, 5, 7, 8, 11, 12, 14].includes(i),
}));
---

<svg class="fig glyph" viewBox="0 0 120 48" aria-hidden="true">
  {job === "qc" && (
    <>
      <rect x="6" y="5" width="40" height="38" rx="4" class="box" />
      <line x1="12" y1="15" x2="40" y2="15" class="ln" />
      <line x1="12" y1="24" x2="40" y2="24" class="ln" />
      <line x1="12" y1="33" x2="40" y2="33" class="ln" />
      <line x1="46" y1="15" x2="96" y2="13" class="wire k-ok" />
      <line x1="46" y1="24" x2="96" y2="24" class="wire k-bad dash" />
      <line x1="46" y1="33" x2="96" y2="35" class="wire k-ok" />
      <rect x="96" y="8" width="10" height="10" rx="2" class="node k-source" />
      <rect x="96" y="19" width="10" height="10" rx="2" class="node k-source" />
      <rect x="96" y="30" width="10" height="10" rx="2" class="node k-source" />
    </>
  )}
  {job === "validate" && (
    <>
      {[8, 18, 28, 38].map((y) => (
        <rect x="8" y={y - 4} width="10" height="8" rx="2" class="node k-source" />
      ))}
      <path d="M24 24 H52" class="ln" />
      <path d="M52 24 L66 13 M52 24 L66 35" class="ln" />
      <rect x="68" y="5" width="44" height="16" rx="4" class="node k-ok" />
      <rect x="68" y="27" width="44" height="16" rx="4" class="node k-bad" />
      <rect x="73" y="9" width="8" height="8" rx="2" class="solid k-ok" />
      <rect x="84" y="9" width="8" height="8" rx="2" class="solid k-ok" />
      <rect x="95" y="9" width="8" height="8" rx="2" class="solid k-ok" />
      <rect x="73" y="31" width="8" height="8" rx="2" class="solid k-bad" />
    </>
  )}
  {job === "dataset" && (
    <>
      <rect x="6" y="4" width="16" height="18" rx="3" class="node k-source" />
      <rect x="6" y="26" width="16" height="18" rx="3" class="node k-source" />
      <rect x="28" y="15" width="16" height="18" rx="3" class="node k-source" />
      <path d="M48 24 H66" class="ln" />
      <rect x="68" y="6" width="46" height="36" rx="4" class="node k-transform" />
      <path d="M68 18 H114 M68 30 H114 M83 6 V42 M99 6 V42" class="wire k-transform" />
    </>
  )}
  {job === "evidence" && (
    <>
      {[[8, 8], [22, 14], [10, 26], [26, 32], [16, 38]].map(([x, y]) => (
        <rect x={x} y={y - 4} width="12" height="8" rx="2" class="node k-source" />
      ))}
      <path d="M44 24 H58 M58 24 L70 13 M58 24 L70 35" class="ln" />
      <rect x="72" y="9" width="12" height="8" rx="2" class="node k-ok" />
      <rect x="87" y="9" width="12" height="8" rx="2" class="node k-ok" />
      <rect x="102" y="9" width="12" height="8" rx="2" class="node k-ok" />
      <rect x="72" y="31" width="12" height="8" rx="2" class="node k-bad" />
      <rect x="87" y="31" width="12" height="8" rx="2" class="node k-bad" />
    </>
  )}
  {job === "market" && (
    <>
      {grid.map((c) => (
        <rect x={c.x} y={c.y} width="12" height="8" rx="2" class:list={c.on ? ["node", "k-transform"] : ["box"]} />
      ))}
    </>
  )}
  {job === "revision" && (
    <>
      <rect x="30" y="4" width="60" height="40" rx="4" class="box" />
      <line x1="38" y1="13" x2="82" y2="13" class="ln" />
      <line x1="38" y1="21" x2="70" y2="21" class="wire k-bad" />
      <line x1="38" y1="29" x2="78" y2="29" class="wire k-ok" />
      <line x1="38" y1="37" x2="64" y2="37" class="ln" />
      <line x1="34" y1="21" x2="74" y2="21" class="wire k-bad" />
    </>
  )}
</svg>

<style>
  .glyph {
    width: 120px;
    height: 48px;
  }
</style>
