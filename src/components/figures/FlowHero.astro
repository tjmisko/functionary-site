  { t: T.reps, out: T.settle, text: "Same input, same wires, five independent passes." },
  { t: T.settle, out: T.deliver, text: "Where the passes disagree, the method leaves room for more than one answer. That is the part to understand better." },
  { t: T.deliver, out: T.share, text: "The answer now arrives with its data, its method and a record of every step." },
  { t: T.share, out: null, text: "Work a colleague can reproduce and check. Work you can stand behind." },
];

// ---- replicate ------------------------------------------------------------
const REPS = 5;
/** Depth between lanes, in hundredths of the figure's width. */
const DZ = 4.5;
/** Which repeat lands apart from the others in the lane the camera watches. */
const ODD = 3;
const lanes = Array.from({ length: REPS }, (_, j) => {
  const q = rng(300 + j * 7);
  const a1 = 8 + q() * 3;
  const a2 = 18 + q() * 8;
  return {
    j,
    k: j + 1,
    path:
      `M ${JIG.x} ${CY} L 320 ${CY}${seg(meander(320, 390, CY + 12, a1 * 0.75, 410 + j * 13))} ` +
      `L 406 ${CY}${seg(meander(406, 458, CY + 2, a2, 520 + j * 17))} L ${JIG.x + JIG.w} ${CY}`,
    inModule: throughModule(12 + q() * 5, 610 + j * 41),
    t: T.reps + j * 0.2,
    odd: j === ODD,
  };
});
const RUN = 1.7;

const MX = 880;
const gridY = (i: number) => CY - 93 + i * 24;
const differs = new Set([`1:${ODD}`, "4:1", "4:4", "6:2", `6:${ODD}`]);
const agree = (i: number) => REPS - [...differs].filter((d) => d.startsWith(`${i}:`)).length;
const rowsN = 8;
const beats = captions.slice(1).map((c) => (c.t / T.end) * 100);

// ---- cards: each sheet again, as a card that turns over to show its source
const cards = [
  { at: { x: BRIEF.x, y: BRIEF.y }, box: { x: BRIEF.x, y: BRIEF.y, w: BRIEF.w, h: BRIEF.h }, name: BRIEF.title, file: BRIEF.file, note: BRIEF.note, tab: BRIEF.tab, module: false, nodes: briefNodes, wires: briefWires, ports: briefPorts },
  { at: PD.home, box: { x: 0, y: 0, w: PD.w, h: PD.h }, name: PD.title, file: PD.file, note: "module", tab: PD.tab, module: true, nodes: [...PD.core, ...PD.extra], wires: [...PD.coreWires, ...PD.extraWires], ports: PD.ports },
].map((sh) => {
  const place = `left:${(sh.at.x / W) * 100}%; top:${(sh.at.y / H) * 100}%; width:${(sh.box.w / W) * 100}%; height:${(sh.box.h / H) * 100}%`;
  const shown = `fh-in 0.12s ${(T.flip - 0.12).toFixed(2)}s both, fh-out 0.12s ${(T.unflip + FLIP + 0.05).toFixed(2)}s forwards`;
  return {
    box: sh.box,
    name: sh.name,
    file: sh.file,
    note: sh.note,
    tab: sh.tab,
    module: sh.module,
    nodes: sh.nodes,
    wires: sh.wires,
    ports: sh.ports,
    work: [] as string[],
    done: [] as string[],
    reps: [] as { d: string; dim: string }[],
    jig: null,
    aside: null,
    source: SOURCE[sh.file],
    coverStyle: `${place}; animation: ${shown}`,
    faceStyle: `animation: ${shown}`,
    // Both cards turn at the same moment.
    style: `${place}; animation: fh-flip ${FLIP}s ${T.flip.toFixed(2)}s linear both, fh-unflip ${FLIP}s ${T.unflip.toFixed(2)}s linear forwards`,
  };
});

// ---- camera ---------------------------------------------------------------
const FACE = "translate3d(0, 0, 0) rotateX(0deg) rotateY(0deg) scale(1)";
const TILT = "translate3d(1cqw, -1cqw, 0) rotateX(-13deg) rotateY(20deg) scale(1)";
const css = `
@keyframes fh-cam {
  0%, ${pct(T.lift)} { transform: ${FACE}; animation-timing-function: cubic-bezier(0.6, 0, 0.2, 1); }
  ${pct(T.lift + LIFT)}, ${pct(T.settle)} { transform: ${TILT}; animation-timing-function: cubic-bezier(0.6, 0, 0.2, 1); }
  ${pct(T.settle + SETTLE)}, 100% { transform: ${FACE}; }
}
${[...stages.flatMap((st) => [st.box, st.cloud, st.band]), ...sideLanes.flatMap((g) => [g.cloud, g.band]), mainGlow].map((g) => g.css).join("\n")}
${lookCss}
.fh .world { animation: fh-cam ${T.end}s linear both; }
.fh .clock { animation: fh-clock ${T.end}s linear both; }
.fh .lift { animation: fh-lift ${LIFT}s ${T.lift}s cubic-bezier(0.6, 0, 0.2, 1) both, fh-drop ${SETTLE}s ${T.settle}s cubic-bezier(0.6, 0, 0.2, 1) forwards; }
.fh .post { animation: fh-post ${LIFT}s ${T.lift}s cubic-bezier(0.6, 0, 0.2, 1) both, fh-unpost ${SETTLE}s ${T.settle}s cubic-bezier(0.6, 0, 0.2, 1) forwards; }
`;
const at = (x: number, y: number) => `left:${((x / W) * 100).toFixed(3)}%; top:${((y / H) * 100).toFixed(3)}%`;
---

<figure class="plate fh">
  <style is:inline set:html={css}></style>
  <div data-hero-stage data-total={T.end} data-beats={JSON.stringify(captions.map((c) => [c.t, c.out ?? T.end]))} data-beat-times={captions.slice(1).map((c) => c.t).join(",")}>
    <div class="ground scroll">
      <div class="frame" style={`--dz:${DZ}cqw; --reps:${REPS}`}>
        <div class="viewport">
          <div class="world">
            <!-- the flow sheet, z = 0 -->
            <svg class="fig base" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="You describe a job. An agent writes it as a flow. The runtime executes the flow and produces results. You react to the results and to the process, and the flow is revised. Over the revisions the flow leaves less to a free-running agent and handles more with explicit, wired blocks. Then a Replicate is placed round the blocks that make a judgement. Those blocks run five times on the same input. Each repeat follows the same wires and takes a different path inside the blocks, and the rows where the repeats disagree are marked.">
              <defs>
                <marker id="fh-ah" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
                  <path d="M0 0L8 4L0 8z" class="arrow" />
                </marker>
                <marker id="fh-ah-read" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
                  <path d="M0 0L8 4L0 8z" class="k-source solid" />
                </marker>
                <marker id="fh-ah-write" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
                  <path d="M0 0L8 4L0 8z" class="k-egress solid" />
                </marker>
                <radialGradient id="fh-glow">
                  <stop offset="0" stop-color="var(--cat-agent)" stop-opacity="0.34" />
                  <stop offset="0.55" stop-color="var(--cat-agent)" stop-opacity="0.2" />
                  <stop offset="1" stop-color="var(--cat-agent)" stop-opacity="0" />
                </radialGradient>
                <filter id="fh-feather" x="-20%" y="-60%" width="140%" height="220%">
                  <feGaussianBlur stdDeviation="2.6" />
                </filter>
              </defs>

              <!-- you -->
              <g class="you">
                <circle cx="34" cy="238" r="7" />
                <path d="M21 262 a13 12 0 0 1 26 0" />
              </g>
              <!-- with no flow there is only the agent at work; the authoring agent arrives with the flow -->
              <line x1="50" y1="250" x2="146" y2="250" class="ln d" pathLength="1" style={draw(DOCK_AT + 0.3, 0.5, T.flow)} marker-end="url(#fh-ah)" />
              <!-- you and the authoring agent work back and forth; it writes the flow -->
              <line x1="50" y1="245" x2="70" y2="245" class="ln d final" pathLength="1" style={draw(T.flow + 0.2, 0.3)} marker-end="url(#fh-ah)" />
              <line x1="72" y1="255" x2="52" y2="255" class="ln d final" pathLength="1" style={draw(T.flow + 0.5, 0.3)} marker-end="url(#fh-ah)" />
              <g class="t final k-agent" style={win(T.flow + 0.2)}>
                <circle cx="104" cy="250" r="30" class="authorfill" />
                <circle cx="104" cy="250" r="30" fill="url(#fh-glow)" />
                <circle cx="104" cy="250" r="30" class="authorring" />
                <text x="104" y="253" class="mid t0 authortext">Authoring</text>
                <text x="104" y="265" class="mid t0 authortext">Agent</text>
              </g>
              <line x1="136" y1="250" x2="147" y2="250" class="ln d final" pathLength="1" style={draw(T.flow + 0.4, 0.3)} marker-end="url(#fh-ah)" />

              <!-- one sheet from the first flow to the end: wide while the whole job is laid out on it, then drawn in round the brief -->
              <rect x={LONG.x} y={LONG.y} width={LONG.w} height={LONG.h} rx="10" class="t final file sheetmorph" style={`transform-origin:${LONG.x}px ${LONG.y}px; --ty:${BRIEF.y - LONG.y}px; --kx:${(BRIEF.w / LONG.w).toFixed(4)}; --ky:${(BRIEF.h / LONG.h).toFixed(4)}; animation: fh-in 0.4s ${(T.flow + 0.2).toFixed(2)}s both, fh-sheet ${PULL}s ${T.pull.toFixed(2)}s ${EASE} both`} />
              <g class="t final tabmove" style={`--ty:${BRIEF.y - LONG.y}px; animation: fh-in 0.4s ${(T.flow + 0.2).toFixed(2)}s both, fh-shift ${PULL}s ${T.pull.toFixed(2)}s ${EASE} both`}>
                <path d={tabPath(LONG.x, LONG.y, BRIEF.tab)} class="tab" />
                <text x={LONG.x + 12} y={LONG.y + 15} class="t0">{BRIEF.title}</text>
              </g>
              <text x={LONG.x + LONG.w - 10} y={LONG.y + 15} class="t end" style={win(T.flow + 0.2, T.pull)}>revision 1</text>
              <text x={BRIEF.x + BRIEF.w - 10} y={BRIEF.y + 15} class="t final end" style={win(T.pull + PULL)}>{BRIEF.note}</text>

              <!-- the wires to and from the agent blocks: the row's, then the regions', then each step's -->
              <g class="t" style={`animation: fh-in 0.4s ${(T.flow + 0.7).toFixed(2)}s both, fh-out 0.2s ${T.pull.toFixed(2)}s forwards`}>
                {baseWires.map((d) => (
                  <path d={d} class="ln" />
                ))}
              </g>
              <g class="t" style={win(T.flow + 0.7, T.s1)}>
                {blockLinks.map((l) => (
                  <path d={l.d} class="ln" />
                ))}
              </g>
              {stepLinks.map((links, k) => (
                <g class="t" style={win([T.s1, T.s2][k] + 0.7, [T.s2, T.s3][k])}>
                  {links.map((l) => (
                    <path d={l.d} class="ln" />
                  ))}
                </g>
              ))}
              <!-- the agent that had the whole job goes into one of the four blocks -->
              <rect x={mainGlow.base.cx - mainGlow.base.w / 2} y={mainGlow.base.cy - mainGlow.base.h / 2} width={mainGlow.base.w} height={mainGlow.base.h} rx="40" fill="url(#fh-glow)" class="t" style={`transform-origin:${mainGlow.base.cx}px ${mainGlow.base.cy}px; ${win(DOCK_AT + 0.3, T.flow + 0.5)}, ${mainGlow.anim}`} />
              <!-- the agent blocks, as the canvas draws them: one soft-edged surface, a header band and a body. Each is left with less at every step, and goes. -->
              {[...stages.map((st) => ({ ...st, t0: T.flow + 0.3, t1: T.s3 + 0.2 })), ...sideLanes.map((g) => ({ ...g, t0: T.s1 + 0.5, t1: T.s2 + 0.75 }))].map((a) => (
                <g class="t" filter="url(#fh-feather)" style={win(a.t0, a.t1)}>
                  <rect x={a.cloud.base.cx - a.cloud.base.w / 2} y={a.cloud.base.cy - a.cloud.base.h / 2} width={a.cloud.base.w} height={a.cloud.base.h} rx="3" class="agentbody" style={`transform-origin:${a.cloud.base.cx}px ${a.cloud.base.cy}px; animation: ${a.cloud.anim}`} />
                  <rect x={a.band.base.cx - a.band.base.w / 2} y={a.band.base.cy - a.band.base.h / 2} width={a.band.base.w} height={a.band.base.h} rx="3" class="agentband" style={`transform-origin:${a.band.base.cx}px ${a.band.base.cy}px; animation: ${a.band.anim}`} />
                </g>
              ))}
              {stages.map((st) => (
                <g class="t" style={win(T.flow + 0.5, T.s1)}>
                  <text x={st.card.x + 8} y={st.card.y + 9.5} class="agenthead">{st.title}</text>
                  {st.fields.map(([name, value], j) => (
                    <>
                      <text x={st.card.x + 12} y={st.card.y + 35 + j * 17} class="agentfield">{name}</text>
                      <text x={st.card.x + 196} y={st.card.y + 35 + j * 17} class="agentfield end val">{value}</text>
                    </>
                  ))}
                </g>
              ))}
              <g class="t" style={win(T.flow + 0.7, T.s1)}>
                {blockPorts.map((pt) => (
                  <circle cx={pt.x} cy={pt.y} r="3.5" class="port" />
                ))}
              </g>
              {stepLinks.map((links, k) => (
                <g class="t" style={win([T.s1, T.s2][k] + 0.7, [T.s2, T.s3][k])}>
                  {links.flatMap((l) => l.ports).map((pt) => (
                    <circle cx={pt.x} cy={pt.y} r="2.6" class="port" />
                  ))}
                </g>
              ))}
              <!-- each skill's region: first a stage of the agent's work, then an agent of its own in a row, then a region of the flow -->
              {stages.map((st) => (
                <>
                  <rect x={st.box.base.cx - st.box.base.w / 2} y={st.box.base.cy - st.box.base.h / 2} width={st.box.base.w} height={st.box.base.h} rx="26" class="t zone sheetmorph" style={`transform-origin:${st.box.base.cx}px ${st.box.base.cy}px; animation: fh-in 0.4s ${(T.skills + 0.9 + st.i * 0.1).toFixed(2)}s both, fh-out 0.4s ${(T.flow + 0.3).toFixed(2)}s forwards, ${st.box.anim}`} />
                </>
              ))}
              {SKILLS.map((s) => (
                <text x={s.chipX + 7} y={s.chipY} class="t skilltext zonetext" style={`--tx:${s.x + 14 - s.chipX - 7}px; --ty:${ZONE.y - 7 - s.chipY}px; animation: fh-in 0.15s ${(T.skills + 0.4 + s.i * 0.1).toFixed(2)}s both, fh-shift 0.8s ${(T.skills + 0.45 + s.i * 0.1).toFixed(2)}s ${EASE} both, fh-out 0.35s ${T.flow.toFixed(2)}s forwards`}>{s.name}</text>
              ))}

              <!-- a beam from each call to its module, behind everything -->
              {MODS.map((m) => (
                <path d={beam(m.call, homeBox(m))} class="t beam" style={win(T.pull + PULL + 0.1, T.tuck)} />
              ))}
              <path d={beam(PD.call, homeBox(PD))} class="t beam" style={win(T.open + 0.3, T.close)} />
              <path d={beam(WE.call, { ...WE_OPEN, w: WE.w, h: WE.h })} class="t beam" style={win(T.mark - 0.2, T.settle + 0.2)} />

              <!-- the wires that join the regions while the whole job is on one sheet; then the brief's own -->
              {longWires.map((w) => (
                <path d={w.d} class="t ln" style={`animation: fh-in 0.4s ${w.at.toFixed(2)}s both, fh-out 0.2s ${T.pull.toFixed(2)}s forwards`} />
              ))}
              {laneFan.map((d) => (
                <path d={d} class="t ln" style={win(T.s1 + 0.5, T.s2)} />
              ))}
              <g class="t" style={`animation: fh-in 0.4s ${(T.s2 + 0.6).toFixed(2)}s both, fh-out 0.2s ${T.pull.toFixed(2)}s forwards`}>
                <FlowNodes nodes={bigMap} />
              </g>
              <g class="t" style={`animation: fh-in 0.4s ${S(3, 0.1).toFixed(2)}s both, fh-out 0.2s ${T.pull.toFixed(2)}s forwards`}>
                <FlowNodes nodes={stageRefine} />
                <path d={stageLoop} class="ln" />
              </g>
              <g class="t final" style={win(T.pull + PULL - 0.1)}>
                {briefWires.map((d) => (
                  <path d={d} class="ln" />
                ))}
              </g>
              <!-- what the brief gains when it is factored: a call for each module, and its jigs -->
              <FlowNodes nodes={briefNew} cls="t final" styleAt={(i) => win(T.pull + PULL - 0.2 + i * 0.05)} />
              <!-- the steps that stay in the brief: the same shapes, travelling from the whole-job sheet to their place in it -->
              <FlowNodes nodes={keptNodes} cls="t final" styleAt={keptStyle} />
              {sideDocs.map((doc) => (
                <FlowNodes nodes={doc.nodes} cls="t" styleAt={() => doc.style} />
              ))}
              <g class="t final" style={win(T.pull + PULL + 0.1)}>
                {briefPorts.map((p) => (
                  <circle cx={p.x} cy={p.y} r="3.5" class="port" />
                ))}
              </g>
              <path d={briefRun.before} class="d work" pathLength="1" style={draw(T.run3, briefRun.dur, T.look)} />
              <path d={briefRun.after} class="d work done" pathLength="1" style={draw(T.run3 + briefRun.dur - 0.1, 0.45, T.look)} />
              {branchWires.map((d, i) => (
                <path d={d} class="d work done" pathLength="1" style={draw(T.run3 + briefRun.dur + 0.6 + i * 0.15, 0.3, T.look)} />
              ))}

              <!-- each module: a region of the whole-job sheet, written out there; then it travels, unchanged, to a sheet of its own -->
              {MODS.map((m) => (
                <g class="t" style={`--tx:${m.long.x - m.home.x}px; --ty:${m.long.y - m.home.y}px; animation: fh-in 0.4s ${m.boxAt.toFixed(2)}s both, fh-unshift ${PULL}s ${T.pull.toFixed(2)}s ${EASE} both, fh-out 0.35s ${T.tuck.toFixed(2)}s forwards`}>
                  <g transform={`translate(${m.home.x} ${m.home.y})`}>
                    <g class="t" style={win(T.pull + PULL - 0.1)}>
                      <rect x="0" y="0" width={m.w} height={m.h} rx="10" class="file modfile" />
                      <path d={tabPath(0, 0, m.tab)} class="tab" />
                      <text x="12" y="15" class="t0">{m.title}</text>
                      <text x={m.w - 10} y="15" class="end">module</text>
                      {m.extraWires.map((d) => (
                        <path d={d} class="ln" />
                      ))}
                      <FlowNodes nodes={m.extra} />
                    </g>
                    <g class="t" style={win(m.calloutAt, T.pull + PULL - 0.1)}>
                      <rect x={m.callout.x} y={m.callout.y} width={m.callout.w} height={m.callout.h} rx="8" class="callout" />
                      <text x={m.callout.x + 6} y={m.callout.y - 5} class="calltext">{m.label}</text>
                    </g>
                    {m.coreWires.map((d, i) => (
                      <path d={d} class="t ln" style={win(m.wireT[i])} />
                    ))}
                    <FlowNodes nodes={m.core} cls="t" styleAt={(i) => win(m.coreT[i])} />
                  </g>
                </g>
              ))}

              <!-- a module open on its own beside the brief: Prepare data when it is looked into, Weigh evidence for the repeats -->
              {opens.map((o) => (
                <g class={o.cls} style={o.style}>
                  <g transform={`translate(${o.at.x} ${o.at.y})`}>
                    <rect x="0" y="0" width={o.m.w} height={o.m.h} rx="10" class="file modfile" />
                    <path d={tabPath(0, 0, o.m.tab)} class="tab" />
                    <text x="12" y="15" class="t0">{o.m.title}</text>
                    <text x={o.m.w - 10} y="15" class="end">module</text>
                    {[...o.m.coreWires, ...o.m.extraWires].map((d) => (
                      <path d={d} class="ln" />
                    ))}
                    <FlowNodes nodes={[...o.m.core, ...o.m.extra]} />
                    {o.m.ports.map((pt) => (
                      <circle cx={pt.x} cy={pt.y} r="3.5" class="port" />
                    ))}
                  </g>
                </g>
              ))}
              <path d={`M 104 281 C 104 ${WE_OPEN.y + 56}, 118 ${WE_OPEN.y + 56}, 146 ${WE_OPEN.y + 56}`} class="ln d" pathLength="1" style={draw(T.mark - 0.2, 0.4, T.settle + 0.2)} marker-end="url(#fh-ah)" />
              <g transform={`translate(${WE_OPEN.x} ${WE_OPEN.y})`}>
                {lanes.map((lane) => (
                  <path d={lane.inModule} class="d work rep" pathLength="1" style={`${draw(lane.t, RUN, T.settle + 0.2)}; --dim:${(0.55 + 0.45 * (lane.k / REPS)).toFixed(2)}`} />
                ))}
              </g>

              <!-- reading the flow: a person goes from step to step -->
              {lookRings.map((r) => (
                <rect x={r.x - 4} y={r.y - 4} width={r.w + 8} height={r.h + 8} rx="11" class="t ring" style={win(r.t0, r.t1)} />
              ))}
              <g class="t you looker" style={`${win(T.look, T.close)}, fh-look ${T.end}s linear both`}>
                <circle cx="0" cy="-8" r="4.5" />
                <path d="M -8 7 a8 7.5 0 0 1 16 0" />
              </g>

              <!-- act 1: with no flow, the agent's work is a run of tool calls -->
              <g class="t" style={win(T.agentIn + 0.3, T.flow)}>
                <rect x="170" y="424" width="12" height="9" rx="1.5" class="k-source node square" />
                <text x="187" y="432" class="k-source tc">sources</text>
                <rect x="252" y="424" width="12" height="9" rx="1.5" class="k-egress node square" />
                <text x="269" y="432" class="k-egress tc">effects</text>
              </g>
              {pool.map((spot, i) => (
                <g class={`t ${spot.kind === "read" ? "k-source" : "k-egress"}`} style={win(T.agentIn + 0.2 + i * 0.03, T.flow + 0.1)}>
                  <rect x={spot.x - 13} y={spot.y - 7.5} width="26" height="15" rx="1.5" class="node square dim" />
                </g>
              ))}
              {freeRuns.map((run) => (
                <>
                  <path d={run.d} class="d work free" pathLength="1" style={draw(run.t, WANDER, run.out)} />
                  {run.calls.map((c) => (
                    <g class={`t ${c.spot.kind === "read" ? "k-source" : "k-egress"}`} style={win(c.t, run.out)}>
                      <rect x={c.spot.x - 13} y={c.spot.y - 7.5} width="26" height="15" rx="1.5" class="node square" />
                      <line x1={c.spot.x - 7} y1={c.spot.y} x2={c.spot.x + 5} y2={c.spot.y} class="wire rule" />
                      <path d={c.d} class="wire call" marker-end={`url(#fh-ah-${c.spot.kind})`} />
                    </g>
                  ))}
                </>
              ))}

              <!-- each agent's prompt, on the top edge of its region -->
              {chips.map((c) => (
