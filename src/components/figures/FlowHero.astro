  `animation: fh-in 0.4s ${t0.toFixed(2)}s both` + (t1 != null ? `, fh-out 0.35s ${t1.toFixed(2)}s forwards` : "");
const draw = (t0: number, dur: number, t1?: number | null) =>
  `animation: fh-draw ${dur}s ${t0.toFixed(2)}s both, fh-in 0.15s ${t0.toFixed(2)}s both` +
  (t1 != null ? `, fh-out 0.35s ${t1.toFixed(2)}s forwards` : "");
const cls = (base: string, t1?: number | null) => (t1 == null ? `${base} final` : base);

// ---- drawing helpers ------------------------------------------------------

/**
 * An agent's path from (x0, y) to (x1, y), within about ±amp: uneven swings
 * with an occasional loop. Between a tight coil and a zigzag.
 */
function meander(x0: number, x1: number, y: number, amp: number, seed: number): P[] {
  const q = rng(seed);
  const L = x1 - x0;
  const waves = Math.max(1, L / 85) * (0.8 + 0.5 * q());
  const ph = [q() * 6.28, q() * 6.28];
  const count = L < 90 ? (q() < 0.7 ? 1 : 0) : Math.max(1, Math.round(L / 130 + (q() - 0.5)));
  const loops = Array.from({ length: count }, (_, i) => ({
    c: (i + 0.5 + (q() - 0.5) * 0.6) / count,
    r: amp * (0.26 + 0.2 * q()),
    w: Math.min(0.45, (34 + q() * 14) / L),
    dir: q() < 0.5 ? -1 : 1,
  }));
  const steps = Math.max(28, Math.round(L / 3.5));
  const pts: P[] = [];
  for (let i = 0; i <= steps; i++) {
    const s = i / steps;
    const env = Math.pow(Math.sin(Math.PI * s), 0.6);
    let px = x0 + s * L;
    let py = y + amp * 0.62 * env * (0.7 * Math.sin(2 * Math.PI * waves * s + ph[0]) + 0.3 * Math.sin(2 * Math.PI * waves * 2.3 * s + ph[1]));
    for (const loop of loops) {
      const u = (s - loop.c) / loop.w + 0.5;
      if (u <= 0 || u >= 1) continue;
      px -= loop.r * Math.sin(2 * Math.PI * u);
      py += loop.dir * loop.r * (1 - Math.cos(2 * Math.PI * u));
    }
    pts.push({ x: px, y: Math.min(y + amp, Math.max(y - amp, py)) });
  }
  pts[0] = { x: x0, y };
  pts[pts.length - 1] = { x: x1, y };
  return pts;
}
/** A spline's curve commands, without its leading move. */
const seg = (pts: P[]) => spline(pts).replace(/^M [\d.-]+ [\d.-]+/, "");
const wire = (x1: number, y1: number, x2: number, y2: number) => {
  const d = Math.max(12, Math.abs(x2 - x1) * 0.5);
  return `M ${x1} ${y1} C ${x1 + d} ${y1}, ${x2 - d} ${y2}, ${x2} ${y2}`;
};


// Before any flow exists, the agent works by tool calls: it reads sources as
// it goes, and near the end it writes and takes effect.
// One fixed set of sources and possible effects. Each time the agent is asked
// it takes a different route and touches a different part of the set.
type Spot = P & { kind: "read" | "write" };
const pool: Spot[] = [];
{
  const q = rng(23);
  const place = (kind: Spot["kind"], n: number, xa: number, xb: number) => {
    let placed = 0;
    for (let tries = 0; placed < n && tries < 400; tries++) {
      const spot = { kind, x: xa + q() * (xb - xa), y: 150 + q() * 212 };
      if (pool.every((o) => Math.hypot(o.x - spot.x, (o.y - spot.y) * 1.6) > 44)) {
        pool.push(spot);
        placed++;
      }
    }
  };
  place("read", 9, 188, 610);
  place("write", 8, 470, 824);
}
/** The arrowed calls one run makes to the spots it uses. */
function calls(pts: P[], used: number[], t0: number, dur: number) {
  return used.map((id) => {
    const spot = pool[id];
    let best = 0;
    pts.forEach((pt, i) => {
      if (Math.hypot(pt.x - spot.x, pt.y - spot.y) < Math.hypot(pts[best].x - spot.x, pts[best].y - spot.y)) best = i;
    });
    const at = pts[best];
    // Stop the arrow at the box's edge, not its middle.
    const dx = at.x - spot.x;
    const dy = at.y - spot.y;
    const k = Math.min(1, 13 / Math.max(1e-6, Math.abs(dx)), 7.5 / Math.max(1e-6, Math.abs(dy)));
    const edge = { x: spot.x + dx * k, y: spot.y + dy * k };
    const [from, to] = spot.kind === "read" ? [edge, at] : [at, edge];
    return { spot, d: `M ${from.x.toFixed(1)} ${from.y.toFixed(1)} L ${to.x.toFixed(1)} ${to.y.toFixed(1)}`, t: t0 + (best / (pts.length - 1)) * dur };
  });
}
