        </div>
        <!-- subtitles: one per beat, centred in a band under the drawing -->
        <div class="caps">
          {captions.map((c) => (
            <p class={cls("t cap", c.out)} style={`animation: fh-in 0.3s ${(c.t + 0.25).toFixed(2)}s both` + (c.out != null ? `, fh-out 0.2s ${c.out.toFixed(2)}s forwards` : "")}><span>{c.text}</span></p>
          ))}
        </div>
      </div>
    </div>
    <div class="bar">
      <button type="button" class="toggle" data-toggle aria-label="Pause the animation">Pause</button>
      <div class="track">
        <div class="fill clock"></div>
        {beats.map((b) => (
          <span class="beat" style={`left:${b.toFixed(2)}%`} />
        ))}
        <input type="range" data-scrub min="0" max={T.end} step="0.01" value="0" aria-label="Position in the animation" />
      </div>
    </div>
  </div>
</figure>

<script>
  /**
   * One clock for the figure. Every CSS animation under the stage is paused
   * and given its time from here, so the figure can be played, paused,
   * scrubbed and frozen at a frame (`?t=<seconds>`, used by the capture
   * harness in scripts/hero-frames.mjs).
   */
  type Timed = { a: Animation; t0: number; t1: number };

  function mount(stage: HTMLElement) {
    const total = Number(stage.dataset.total) * 1000;
    const scrub = stage.querySelector<HTMLInputElement>("[data-scrub]")!;
    const toggle = stage.querySelector<HTMLButtonElement>("[data-toggle]")!;
    const timed: Timed[] = stage.getAnimations({ subtree: true }).map((a) => {
      const c = a.effect!.getComputedTiming();
      a.pause();
      return { a, t0: c.delay ?? 0, t1: Number(c.endTime ?? total) };
    });

    let now = 0;
    let playing = false;
    let last = 0;

    // Only animations whose window the move crosses can change what they draw.
    const seek = (ms: number, all = false) => {
      const to = Math.min(total, Math.max(0, ms));
      const lo = Math.min(now, to);
      const hi = Math.max(now, to);
      for (const { a, t0, t1 } of timed) {
        if (all || (t0 <= hi && t1 >= lo)) a.currentTime = to;
      }
      now = to;
      scrub.value = String(to / 1000);
    };
    const label = () => {
      const text = playing ? "Pause" : now >= total ? "Replay" : "Play";
      toggle.textContent = text;
      toggle.setAttribute("aria-label", `${text} the animation`);
    };
    const frame = (stamp: number) => {
      if (!playing) return;
      seek(now + (stamp - last));
      last = stamp;
      if (now >= total) {
        playing = false;
        label();
        return;
      }
      requestAnimationFrame(frame);
    };
    const play = () => {
      if (now >= total) seek(0, true);
      playing = true;
      last = performance.now();
      label();
      requestAnimationFrame(frame);
    };
    const pause = () => {
      playing = false;
      label();
    };

    // When the figure is pinned inside a tall section, the scroll position
    // sets the clock. It plays by itself until the reader first scrolls.
    const section = stage.closest<HTMLElement>("[data-hero-scroll]");
    const pin = section?.firstElementChild as HTMLElement | null;
    const pinned = () => !!section && !!pin && getComputedStyle(pin).position === "sticky";
    const travel = () => section!.offsetHeight - pin!.offsetHeight;
    const pinTop = () => parseFloat(getComputedStyle(pin!).top) || 0;
    const progress = () => Math.min(1, Math.max(0, (pinTop() - section!.getBoundingClientRect().top) / Math.max(1, travel())));
    let following = false;
    let target = 0;
    const follow = () => {
      if (playing) {
        following = false;
        return;
      }
      const gap = target - now;
      seek(Math.abs(gap) < 8 ? target : now + gap * 0.18);
      label();
      if (now === target) {
        following = false;
        return;
      }
      requestAnimationFrame(follow);
    };
    const onScroll = () => {
      if (!pinned()) return;
      const p = progress();
      // Stay with autoplay until the reader has actually moved the page.
      if (playing && p < 0.004) return;
      playing = false;
      target = p * total;
      if (!following) {
        following = true;
        requestAnimationFrame(follow);
      }
    };

    toggle.addEventListener("click", () => (playing ? pause() : play()));
    scrub.addEventListener("input", () => {
      pause();
      const to = Number(scrub.value) * 1000;
      if (pinned()) {
        // Move the page, so the scroll position and the clock stay in step.
        const top = section!.getBoundingClientRect().top + scrollY - pinTop();
        scrollTo({ top: top + (to / total) * travel() });
        return;
      }
      seek(to);
    });

    // Keyboard: Space play/pause, Home/End, Left/Right by beat, 0-9 by
    // proportion (0 = start, 9 = 90%). Up/Down are left to the scrubber.
    const beats = (stage.dataset.beatTimes ?? "")
      .split(",")
      .map((s) => Number(s) * 1000)
      .filter((n) => Number.isFinite(n))
      .sort((x, y) => x - y);
    const EPS = 50;
    const jump = (ms: number) => {
      pause();
      seek(ms);
    };
    const inView = () => {
      const r = stage.getBoundingClientRect();
      return r.bottom > 0 && r.top < innerHeight;
    };
    document.addEventListener("keydown", (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey || e.defaultPrevented) return;
      const el = e.target as HTMLElement | null;
      if (el && (el.isContentEditable || /^(TEXTAREA|SELECT|A|BUTTON)$/.test(el.tagName))) return;
      if (el && el.tagName === "INPUT" && el !== scrub) return;
      if (!inView()) return;
      let handled = true;
      if (e.key === " ") (playing ? pause() : play());
      else if (e.key === "Home") jump(0);
      else if (e.key === "End") jump(total);
      else if (e.key === "ArrowLeft") jump([...beats].reverse().find((b) => b < now - EPS) ?? 0);
      else if (e.key === "ArrowRight") jump(beats.find((b) => b > now + EPS) ?? total);
      else if (/^[0-9]$/.test(e.key)) jump((Number(e.key) / 10) * total);
      else handled = false;
      if (handled) e.preventDefault();
    });

    const frozen = new URLSearchParams(location.search).get("t");
    seek(0, true);
    if (frozen != null) {
      seek(Number(frozen) * 1000, true);
      label();
    } else {
      play();
      addEventListener("scroll", onScroll, { passive: true });
      addEventListener("resize", onScroll);
    }
    (stage as HTMLElement & { hero?: unknown }).hero = { seek: (s: number) => (pause(), seek(s * 1000, true)), play, pause };
  }

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>("[data-hero-stage]").forEach(mount);
  }
</script>

<style is:global>
  @keyframes fh-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes fh-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  @keyframes fh-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes fh-clock {
    from { width: 0%; }
    to { width: 100%; }
  }
  @keyframes fh-lift {
    from { transform: translateZ(0); }
    to { transform: translateZ(calc(var(--k) * var(--dz))); }
  }
  @keyframes fh-drop {
    from { transform: translateZ(calc(var(--k) * var(--dz))); }
    to { transform: translateZ(0); }
  }
  /* A card turns about its own middle, so it comes forward as it turns to stay clear of the sheet behind it. */
  @keyframes fh-shift {
    from { transform: translate(0px, 0px); }
    to { transform: translate(var(--tx, 0px), var(--ty, 0px)); }
  }
  /* Drawn where it ends up; starts displaced, and travels home. */
  @keyframes fh-unshift {
    from { transform: translate(var(--tx, 0px), var(--ty, 0px)); }
    to { transform: translate(0px, 0px); }
  }
  /* The long flow's sheet draws in to the brief's. */
  @keyframes fh-sheet {
    from { transform: translate(0px, 0px) scale(1, 1); }
    to { transform: translate(0px, var(--ty)) scale(var(--kx), var(--ky)); }
  }
  /* A skill's region moves and resizes into its region of the flow. */
  @keyframes fh-box {
    from { transform: translate(0px, 0px) scale(1, 1); }
    to { transform: translate(var(--tx), var(--ty)) scale(var(--kx), var(--ky)); }
  }
  /* A module opens out of the block that calls it. */
  @keyframes fh-pop {
    from { opacity: 0; transform: scale(0.1); }
    to { opacity: 1; transform: scale(1); }
  }
  @keyframes fh-pull {
    from { transform: translate(0px, 0px) scale(1); }
    to { transform: translate(var(--tx), var(--ty)) scale(var(--k)); }
  }
  @keyframes fh-flip {
    0% { transform: translateZ(1px) rotateY(0deg); animation-timing-function: ease-in; }
    50% { transform: translateZ(34cqw) rotateY(90deg); animation-timing-function: ease-out; }
    100% { transform: translateZ(1px) rotateY(180deg); }
  }
  @keyframes fh-unflip {
    0% { transform: translateZ(1px) rotateY(180deg); animation-timing-function: ease-in; }
    50% { transform: translateZ(34cqw) rotateY(270deg); animation-timing-function: ease-out; }
    100% { transform: translateZ(1px) rotateY(360deg); }
  }
  @keyframes fh-post {
    from { transform: rotateY(-90deg) scaleX(0); }
    to { transform: rotateY(-90deg) scaleX(1); }
  }
  @keyframes fh-unpost {
    from { transform: rotateY(-90deg) scaleX(1); }
    to { transform: rotateY(-90deg) scaleX(0); }
  }

  /* ---- the scene ---- */
  .fh .frame {
    position: relative;
    container-type: inline-size;
  }
  .fh .viewport {
    perspective: 420cqw;
    perspective-origin: 50% 45%;
    overflow: hidden;
  }
  .fh .world {
    position: relative;
    transform-style: preserve-3d;
    transform-origin: 34.9% 50%;
  }
  .fh .layer {
    position: absolute;
    inset: 0;
    height: 100%;
    pointer-events: none;
    /* Chrome drops a lifted layer that paints nothing of its own, so it paints a tint too faint to see. */
    background: rgb(0 0 0 / 0.004);
  }
  .fh .post {
    position: absolute;
    width: calc(var(--reps) * var(--dz));
    height: 2px;
    margin-top: -1px;
    background: var(--jig);
    opacity: 0.7;
    transform-origin: 0 50%;
    transform: rotateY(-90deg) scaleX(0);
  }

  /* A flow as a two-faced card, and the blank it turns over on. */
  .fh .cover,
  .fh .card {
    position: absolute;
    pointer-events: none;
  }
  /* The blank a card turns over on. It reaches just past the sheet it hides, so no outline shows round the turning card. */
  .fh .cover {
    background: var(--fh-ground);
    border-radius: 0.9cqw;
    box-shadow: 0 0 0 0.35cqw var(--fh-ground);
    transform: translateZ(0.4px);
  }
