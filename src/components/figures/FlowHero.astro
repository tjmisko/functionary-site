                  )}
                  <circle cx={JIG.x} cy={CY} r="3" class="port" />
                  <circle cx={JIG.x + JIG.w} cy={CY} r="3" class="port" />
                </g>
                <path d={lane.path} class="d work rep" pathLength="1" style={`${draw(lane.t, RUN, T.hide)}; --dim:${(0.55 + 0.45 * (lane.k / REPS)).toFixed(2)}`} />
                <g class={`t row ${lane.odd ? "review" : "ok"}`} style={win(lane.t + RUN - 0.1, T.settle + 0.2)}>
                  <path d={page(JIG.x + JIG.w + 8, CY - 10, 17, 19).sheet} />
                  <path d={page(JIG.x + JIG.w + 8, CY - 10, 17, 19).marks} class="docmarks" />
