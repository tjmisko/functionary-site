const MORPH = 0.9;
const EASE = "cubic-bezier(0.6, 0, 0.2, 1)";
/** One agent region, followed through the figure: where it is and how big, from each moment on. */
type Glow = { cx: number; cy: number; w: number; h: number };
function glowTrack(name: string, states: (Glow & { t: number })[]) {
  const b = states[0];
  const tf = (s: Glow) => `translate(${(s.cx - b.cx).toFixed(1)}px, ${(s.cy - b.cy).toFixed(1)}px) scale(${(s.w / b.w).toFixed(4)}, ${(s.h / b.h).toFixed(4)})`;
  const frames = states.map((s, i) => {
    const from = i === 0 ? "0%" : pct(s.t + MORPH);
    const to = states[i + 1] ? pct(states[i + 1].t) : "100%";
    return `  ${from}, ${to} { transform: ${tf(s)}; animation-timing-function: ${EASE}; }`;
  });
  return { name, base: b, css: `@keyframes ${name} {\n${frames.join("\n")}\n}`, anim: `${name} ${T.end}s linear both` };
}

