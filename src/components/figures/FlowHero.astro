/**
 * The timeline: each moment, and the seconds since the one before it. To make
 * a beat longer or shorter, change its gap; everything after it moves along.
 */
const GAPS = {
  ask: 0.3, // you write a prompt
  agentIn: 2.9, // the prompt is handed over; the agent takes the whole job
  again: 3.6, // asked again, it works differently
  skills: 3.2, // skills: named stages the agent is steered through
  problem: 3.8, // it follows them more or less
  flow: 4.2, // the four skills become four agents in a row on one sheet
  place: 2.6, // they move to where the job needs them
  s1: 1.8, // step 1: every part's ends are fixed
  s2: 3.0, // step 2: its structure; the per-source lanes close through a Map
  s3: 3.2, // step 3: what is left becomes blocks
  write3: 3.0, // the whole job is one flow
  call: 3.6, // three parts of it are procedures in their own right
  pull: 2.6, // each travels, unchanged, to a sheet of its own; the rest closes up into the brief
  tuck: 4.6, // the modules tuck away behind their calls
  run3: 0.6, // the brief runs
  look: 3.2, // a person reads the flow: goes from step to step
  open: 4.5, // and opens one: Prepare data
  flip: 2.6, // the brief and the open module turn over to show their source
  unflip: 3.2, // and turn back
  close: 1.4, // the module closes
  mark: 0.6, // Replicate goes round the judgement blocks; Weigh evidence opens
  lift: 2.6, // the camera turns; the lanes lift off the sheet
  reps: 1.6, // each lane runs
  settle: 3.4, // the camera returns; the lanes settle into one bundle
  read: 1.4, // where the repeats disagree
  hide: 4.4, // the point about the paths is made; they go
  deliver: 0.8, // what is delivered: the brief, its data and its method, from a recorded run
  share: 4.6, // and a colleague can reproduce and check it
  end: 4.0,
};
type Moment = keyof typeof GAPS;
const T = {} as Record<Moment, number>;
{
  let t = 0;
  for (const key of Object.keys(GAPS) as Moment[]) {
    t = Math.round((t + GAPS[key]) * 100) / 100;
    T[key] = t;
  }
}
const pct = (t: number) => `${((t / T.end) * 100).toFixed(3)}%`;
/** When something written at step `k` (1 to 3) of the flow's build first shows, plus a stagger. */
const S = (k: number, d = 0) => [T.s1, T.s2, T.s3][k - 1] + 0.3 + d;
/** Seconds an agent's run line takes to draw. */
const WANDER = 1.8;
const LIFT = 1.4;
const SETTLE = 1.3;
const FLIP = 0.7;

