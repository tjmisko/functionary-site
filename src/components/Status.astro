---
/**
 * The one chip the site uses: whether what a figure shows runs on the
 * integration branch today, or is decided and not yet built. Honesty about
 * build state is part of the pitch, so the chip is quiet and always present
 * on a drawing.
 */
interface Props {
  status: "built" | "designed";
}
const { status } = Astro.props;
const label = status === "built" ? "runs today" : "designed, not yet built";
---

<span class={`status ${status}`}>{label}</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-10);
    color: var(--fg-2);
    white-space: nowrap;
  }
  .status::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--fg-3);
  }
  .built::before {
    background: var(--success);
  }
  .designed::before {
    background: transparent;
    border: 1.5px solid var(--warn);
  }
</style>
