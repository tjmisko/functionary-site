---
import { kindCategory, type Kind } from "../lib/flow";
import { iconFor } from "../lib/icons";

/**
 * The block palette: seven kinds of step and the verbs under each, in the
 * canvas's own grouping and colours.
 */
const kinds: { kind: Kind; label: string; job: string; verbs: string[] }[] = [
  { kind: "source", label: "Source", job: "data in", verbs: ["Source"] },
  { kind: "block", label: "Block", job: "a judgement a model makes", verbs: ["Summarize", "Search", "Judge", "Model", "Quote", "Compare", "Draft"] },
  { kind: "agent", label: "Agent", job: "the one free-form step", verbs: ["Sketch agent"] },
  { kind: "transform", label: "Transform", job: "pure work, no model", verbs: ["Format", "Template", "Select", "Filter", "Sort", "Mutate", "Aggregate", "Join", "Stack", "Reshape", "Coalesce"] },
  { kind: "jig", label: "Jig", job: "the visible loop or branch", verbs: ["Map", "Replicate", "Repeat", "Refine", "Retry", "Branch"] },
  { kind: "gate", label: "Gate", job: "decides whether a value goes on", verbs: ["Review", "Check", "Declassify", "Redact"] },
  { kind: "egress", label: "Egress", job: "data out", verbs: ["Write", "Notify", "Apply"] },
];
---

<div class="palette">
  {
    kinds.map((k) => (
      <section class:list={["kind", `kind-${k.kind}`]} style={`--tint: ${kindCategory[k.kind]}`}>
        <header>
          <span class="name">{k.label}</span>
          <span class="job">{k.job}</span>
        </header>
        <ul>
          {k.verbs.map((v) => (
            <li>
              <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                <path d={iconFor(v) ?? ""} />
              </svg>
              {v}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .palette {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: var(--s-10);
  }
  .kind {
    border: 1px solid var(--border-0);
    border-radius: var(--r-8);
    background: var(--bg-1);
    overflow: hidden;
    min-width: 0;
  }
  header {
    padding: var(--s-8) var(--s-10);
    background: color-mix(in srgb, var(--tint) 85%, var(--bg-1));
    display: grid;
    gap: 1px;
  }
  .name {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    font-weight: 700;
    color: #fff;
  }
  .job {
    font-size: var(--fs-10);
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.3;
  }
  .kind-gate .name,
  .kind-gate .job {
    color: #1f1b0a;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: var(--s-10);
    display: grid;
    gap: 6px;
  }
  li {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: var(--fs-11);
    color: var(--fg-0);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  li svg {
    flex: none;
  }
  li svg path {
    fill: none;
    stroke: var(--tint);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 1000px) {
    .palette {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .palette {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
