---
import { kindCategory, extractionTint, originLabel } from "../lib/flow";
import { iconFor } from "../lib/icons";
import type { CanvasFlow, CanvasNode } from "../lib/canvas";

/**
 * A static drawing of a flow in the product's canvas grammar.
 *
 * Taken from the app's stylesheet: a card is a 1px rgba(255,255,255,.12)
 * border on rgba(28,33,40,.95) with an 8px radius and a kind-coloured header
 * carrying a line icon, the verb and a badge; a Transform is a quiet grey
 * pill; a Jig is a translucent orange region that holds its body, with a
 * label above and a footer below; ports are 10px rings on the card edge and
 * every non-source card has a small error port at its lower right. A Source
 * is a near-square card with a lightly tinted header; a Gate is a chamfered outline the wire
 * passes through. Neither has a filled header. A block
 * that calls a model carries a glowing white dot in its header. A table
 * source is a wider Source whose body is the spreadsheet, with a
 * row-number column and 1px row rules.
 *
 * Wires carry the origin axis: Sourced and Computed plain, Generated dashed,
 * Verified and Reviewed tinted. A wire's type appears on hover. `run` plays
 * one pass of execution state left to right, once, and freezes on the
 * finished state under reduced motion.
 */

interface Props {
  flow: CanvasFlow;
  caption?: string;
  legend?: boolean;
  run?: boolean;
  width?: number;
  /** Drawn on the page itself: no border, no grid. */
  bare?: boolean;
}

const { flow, caption, legend = false, run = false, width: NW = 136, bare = false } = Astro.props;

const NH_CARD = 54;
const HEAD = 24;
const NH_PILL = 34;
/** A Template's page: line pitch, padding, and the dog-ear fold. */
const TPL_LINE = 11;
const TPL_PAD = 8;
const TPL_FOLD = 7;
const TW = 212;
const ROW = 15;
const GAP_X = 16;
const PAD = 12;
const JIG_PAD = 8;
const JIG_HEAD = 20;
/** Chamfer depth of a gate's pointed ends. */
const CH = 12;
/** Corner radius of a source: squarer than a card's 8px, not sharp. */
const SR = 3;
/** A Block may grow past the standard width to fit a long mode badge. */
const BLOCK_MAX_W = 172;
const EMPTY_COL_W = 56;
/** Horizontal run a lane-changing wire uses to bend before its target. */
const BEND_W = 40;

// Approximate glyph advances for the fonts the drawing uses.
const MONO_11B = 6.8; // card verb, JetBrains Mono 11px bold
const MONO_10 = 6.2; // pill verb, 10px
const MONO_8 = 5.0; // pill mode and card badge, 8px
const MONO_9 = 5.6; // jig label, 9px
const UI_10_5 = 5.5; // card title, Inter 10.5px
const MONO_9_5 = 5.8; // card query, 9.5px

/**
 * A table source has a fixed width. A Transform pill, a Block card and any
 * other Source are as wide as their text needs and no wider. Everything else takes the standard
 * card width.
 */
function widthOf(n: CanvasNode) {
  if (n.table) return n.table.width ?? TW;
  if (isTemplate(n)) {
    const head = 28 + n.verb.length * MONO_10 + 8 + (n.mode?.length ?? 0) * MONO_8 + 14;
    const page = Math.max(0, ...(n.template ?? []).map((l) => l.length)) * MONO_8 + 2 * TPL_PAD + 16;
    return Math.ceil(Math.max(head, page));
  }
  if (n.kind === "transform") {
    const verb = n.verb.length * MONO_10;
    const mode = (n.mode?.length ?? 0) * MONO_8;
    return Math.ceil(28 + Math.max(verb, mode) + 12);
  }
  if (n.kind === "block") {
    const head = 24 + n.verb.length * MONO_11B + 14 + (n.mode ? n.mode.length * MONO_8 + 12 : 0) + 9;
    const title = (n.title?.length ?? 0) * UI_10_5 + 18;
    return Math.min(BLOCK_MAX_W, Math.ceil(Math.max(head, title, 96)));
  }
  if (n.kind === "source") {
    const head = 24 + n.verb.length * MONO_11B + 10 + (n.mode ? n.mode.length * MONO_8 : 0) + 9;
    const body = n.query ? n.query.length * MONO_9_5 + 18 : (n.title?.length ?? 0) * UI_10_5 + 18;
    return Math.ceil(Math.max(head, body));
  }
  if (n.kind === "egress" && n.query) {
    const head = 24 + n.verb.length * MONO_11B + 10 + (n.mode?.length ?? 0) * MONO_8 + 9;
    return Math.ceil(Math.max(head, n.query.length * MONO_9_5 + 18));
  }
  if (isBareGate(n)) return Math.ceil(2 * CH + 16 + n.verb.length * MONO_11B + 8);
  if (isBareEgress(n)) return Math.ceil(24 + n.verb.length * MONO_11B + 10 + (n.mode?.length ?? 0) * MONO_8 + 9);
  return NW;
}
const hasInput = new Set(flow.edges.map((e) => e.to));
function heightOf(n: CanvasNode) {
  if (n.table) return HEAD + ROW + n.table.rows.length * ROW + 8;
  if (isTemplate(n)) return NH_PILL + (n.template?.length ?? 0) * TPL_LINE + 2 * TPL_PAD;
  if (isBareGate(n)) return NH_PILL;
  if (isBareEgress(n)) return HEAD;
  return n.kind === "transform" ? NH_PILL : NH_CARD;
}

/** A gate with nothing to say beyond its verb draws as a single centered line. */
function isBareGate(n: CanvasNode) {
  return n.kind === "gate" && !n.title && !n.mode;
}

/** An untitled egress is a side effect off the main line: its header alone. */
function isBareEgress(n: CanvasNode) {
  return n.kind === "egress" && !n.title && !n.query;
}

/** Template is the Transform that carries its text with it, drawn as a page beneath its header. */
function isTemplate(n: CanvasNode) {
  return n.kind === "transform" && n.verb === "Template";
}
/** A template line split so its {{slots}} can be tinted. */
function tplParts(line: string) {
  return line.split(TPL_SLOT);
}
const TPL_SLOT = new RegExp("(\\{\\{[^}]*\\}\\})");
/** The y of a node's nth input port. */
function inPortY(n: { y: number; h: number; cy: number } & CanvasNode, _port = 0) {
  return n.cy;
}

const PITCH_Y = flow.pitch ?? 80;
const maxCol = Math.max(...flow.nodes.map((n) => n.col));
const hasJig = flow.nodes.some((n) => n.kind === "jig");

// Column widths: a column is as wide as its widest node. An empty column is
// a narrow channel for a wire climbing between lanes.
const colW: number[] = [];
for (let c = 0; c <= maxCol; c++) {
  const inCol = flow.nodes.filter((n) => n.kind !== "jig" && n.col === c);
  colW[c] = inCol.length ? Math.max(...inCol.map(widthOf)) : EMPTY_COL_W;
}
const colX: number[] = [];
let acc = PAD;
for (let c = 0; c <= maxCol; c++) {
  colX[c] = acc;
  acc += colW[c] + GAP_X;
}

type Placed = CanvasNode & { x: number; y: number; w: number; h: number; cx: number; cy: number };

const topY = PAD + (hasJig ? JIG_HEAD : 0);
let placed: Placed[] = flow.nodes
  .filter((n) => n.kind !== "jig")
  .map((n) => {
    const w = widthOf(n);
    const h = heightOf(n);
    const x = colX[n.col] + (colW[n.col] - w) / 2;
    const cy = topY + n.lane * PITCH_Y + NH_CARD / 2;
    // A Template's header sits on the line; its page hangs below.
    const y = isTemplate(n) ? cy - NH_PILL / 2 : cy - h / 2;
    return { ...n, x, y, w, h, cx: x + w / 2, cy };
  });

let byId = new Map(placed.map((p) => [p.id, p]));

function placeJigs(nodes: Placed[]) {
  const map = new Map(nodes.map((p) => [p.id, p]));
  return flow.nodes
    .filter((n) => n.kind === "jig")
    .map((j) => {
      const members = (j.body ?? []).map((id) => map.get(id)!).filter(Boolean);
      const x0 = Math.min(...members.map((m) => m.x)) - JIG_PAD;
      const x1 = Math.max(...members.map((m) => m.x + m.w)) + JIG_PAD;
      const y0 = Math.min(...members.map((m) => m.y)) - JIG_PAD - JIG_HEAD;
      const y1 = Math.max(...members.map((m) => m.y + m.h)) + JIG_PAD;
      return { ...j, x: x0, y: y0, w: x1 - x0, h: y1 - y0 };
    });
}

// A tall card can poke above the first lane; shift everything so the
// drawing starts at PAD.
let jigs = placeJigs(placed);
const minTop = Math.min(...placed.map((p) => p.y), ...jigs.map((j) => j.y));
const shift = PAD - minTop;
if (shift !== 0) {
  placed = placed.map((p) => ({ ...p, y: p.y + shift, cy: p.cy + shift }));
  byId = new Map(placed.map((p) => [p.id, p]));
  jigs = placeJigs(placed);
}

const vw = acc - GAP_X + PAD;
const vh = Math.max(...placed.map((p) => p.y + p.h), ...jigs.map((j) => j.y + j.h)) + PAD;

/** The Jig whose body holds a node, if any. */
function jigOf(id: string) {
  return jigs.find((j) => j.body?.includes(id));
}

const R = 8;
/** Where a captured wire enters its target's lower edge, from the left. */
const CAPTURE_INSET = 28;

const edges = flow.edges.map((e, i) => {
  const a = byId.get(e.from)!;
  const b = byId.get(e.to)!;
  const x1 = a.x + a.w + 5;
  const y1 = a.cy;
  const x2 = b.x - 5;
  const y2 = inPortY(b, e.toPort);
  const base = { ...e, id: `${flow.id}-e${i}`, origin: e.origin ?? "computed", col: a.col };

  // A capture: a value from outside a Jig wired to a step inside it. The wire
  // runs along its own lane, turns up through the Jig's edge at a port, and
  // enters its target from below, so the crossing reads as its own link.
  const jig = e.capture ? jigOf(e.to) : undefined;
  if (jig) {
    const xc = b.x + CAPTURE_INSET;
    const d = `M ${x1} ${y1} H ${xc - R} Q ${xc} ${y1} ${xc} ${y1 - R} V ${b.y + b.h + 5}`;
    return { ...base, d, mx: (x1 + xc) / 2, my: y1, capture: { x: xc, y: jig.y + jig.h, port: b.y + b.h } };
  }

  // A wire that changes lane across several columns runs along its own lane
  // and bends only in the last gap, so it never cuts through the steps between.
  // The bend widens with the climb so every lane change reads as an S, never a hook.
  const bendW = Math.max(BEND_W, Math.abs(y2 - y1) * 1.6);
  const bendX = y1 !== y2 && b.col - a.col > 1 ? Math.max(x1, x2 - bendW) : x1;
  const dx = Math.max(0, x2 - bendX) * 0.45;
  const d = `M ${x1} ${y1} H ${bendX} C ${bendX + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`;
  return { ...base, d, mx: (x1 + x2) / 2, my: (y1 + y2) / 2, capture: undefined };
});

function tableColX(n: Placed, ci: number) {
  const ws = n.table!.widths ?? n.table!.columns.map(() => 1);
  const total = ws.reduce((a, b) => a + b, 0);
  const avail = n.w - 28;
  let off = 0;
  for (let i = 0; i < ci; i++) off += (avail * ws[i]) / total;
  return n.x + 24 + off;
}

/** The model dot sits just left of the mode badge, or in the corner without one. */
function dotInset(n: CanvasNode) {
  return n.mode ? Math.ceil(9 + n.mode.length * MONO_8 + 8) : 12;
}

function tint(n: CanvasNode) {
  if (n.kind === "block" && n.extraction) return extractionTint;
  return kindCategory[n.kind];
}

const origins = Array.from(new Set(edges.map((e) => e.origin)));
const minWidth = Math.round(vw * 0.72);
---

<figure class:list={["canvas", { run, bare }]} style={`--min-w: ${minWidth}px`}>
  <div class="stage">
    <svg viewBox={`0 0 ${vw} ${vh}`} role="img" aria-label={flow.aria} preserveAspectRatio="xMidYMid meet">
      <defs>
        <pattern id={`grid-${flow.id}`} width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="1" class="grid-dot" />
        </pattern>
        <filter id={`glow-${flow.id}`} x="-100%" y="-100%" width="300%" height="300%">
          <feGaussianBlur stdDeviation="1.6" />
        </filter>
      </defs>
      {!bare && <rect x="0" y="0" width={vw} height={vh} fill={`url(#grid-${flow.id})`} />}

      {jigs.map((j) => (
        <g class="jig">
          <rect x={j.x} y={j.y} width={j.w} height={j.h} rx="10" class="jig-region" />
          <g transform={`translate(${j.x + 10}, ${j.y + 5}) scale(0.68)`} class="jig-icon">
            <path d={iconFor(j.verb) ?? ""} />
          </g>
          <text x={j.x + 25} y={j.y + 14} class="jig-label">
            {j.verb.toUpperCase()}
            {j.mode && <tspan class="jig-mode"> {j.mode}</tspan>}
          </text>
          {j.foot && (
            <text x={j.x + 25 + (j.verb.length + 1 + (j.mode?.length ?? 0)) * MONO_9 + 14} y={j.y + 14} class="jig-foot">
              {j.foot}
            </text>
          )}
        </g>
      ))}

      {edges.map((e) => (
        <g class={`edge origin-${e.origin}`} style={`--i: ${e.col}`}>
          <path d={e.d} class="wire" />
          {run && <path d={e.d} class="wire-run" />}
          <path d={e.d} class="wire-hit" />
          {e.capture && (
            <g>
              <circle cx={e.capture.x} cy={e.capture.y} r="4" class="capture-port" />
              <circle cx={e.capture.x} cy={e.capture.port} r="5" class="port" />
            </g>
          )}
          {e.label && (
            <g class="wire-tip">
              <rect x={e.mx - e.label.length * 3.1 - 6} y={e.my - 19} width={e.label.length * 6.2 + 12} height="15" rx="3" class="tip-bg" />
              <text x={e.mx} y={e.my - 8.5} text-anchor="middle" class="wire-label">
                {e.label}
              </text>
            </g>
          )}
        </g>
      ))}

      {placed.map((n) =>
        isTemplate(n) ? (
          <g class="node pill template" style={`--tint: ${tint(n)}; --i: ${n.col}`}>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx={NH_PILL / 2} class="pill-body" />
            <circle cx={n.x} cy={n.cy} r="5" class="port" />
            <circle cx={n.x + n.w} cy={n.cy} r="5" class="port" />
            <g transform={`translate(${n.x + 12}, ${n.cy - 6}) scale(0.75)`} class="pill-icon">
              <path d={iconFor(n.verb) ?? ""} />
            </g>
            <text x={n.x + 28} y={n.cy + 4} class="pill-verb">
              {n.verb}
            </text>
            {n.mode && (
              <text x={n.x + n.w - 14} y={n.cy + 3} text-anchor="end" class="pill-mode">
                {n.mode}
              </text>
            )}
            {(() => {
              const px = n.x + 8;
              const py = n.y + NH_PILL - 4;
              const pw = n.w - 16;
              const ph = n.h - NH_PILL - 4;
              return (
                <g class="tpl-page">
                  <path
                    d={`M ${px} ${py} H ${px + pw - TPL_FOLD} L ${px + pw} ${py + TPL_FOLD} V ${py + ph} H ${px} Z`}
                    class="tpl-sheet"
                  />
                  <path d={`M ${px + pw - TPL_FOLD} ${py} V ${py + TPL_FOLD} H ${px + pw}`} class="tpl-fold" />
                  {(n.template ?? []).map((line, li) => (
                    <text x={px + TPL_PAD} y={py + TPL_PAD + 7 + li * TPL_LINE} class="tpl-line">
                      {tplParts(line).map((part) =>
                        part.startsWith("{{") ? <tspan class="tpl-slot">{part}</tspan> : part,
                      )}
                    </text>
                  ))}
                </g>
              );
            })()}
          </g>
        ) : n.kind === "transform" ? (
          <g class="node pill" style={`--tint: ${tint(n)}; --i: ${n.col}`}>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx={n.h / 2} class="pill-body" />
            <circle cx={n.x} cy={n.cy} r="5" class="port" />
            <circle cx={n.x + n.w} cy={n.cy} r="5" class="port" />
            <g transform={`translate(${n.x + 12}, ${n.cy - 6}) scale(0.75)`} class="pill-icon">
              <path d={iconFor(n.verb) ?? ""} />
            </g>
            <text x={n.x + 28} y={n.cy + (n.mode ? -1 : 4)} class="pill-verb">
              {n.verb}
            </text>
            {n.mode && (
              <text x={n.x + 28} y={n.cy + 11} class="pill-mode">
                {n.mode}
              </text>
            )}
          </g>
        ) : n.table ? (
          <g class={`node card table kind-${n.kind}`} style={`--tint: ${tint(n)}; --i: ${n.col}`}>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx={SR} class="source-body" />
            <path
              d={`M ${n.x} ${n.y + SR} a ${SR} ${SR} 0 0 1 ${SR} ${-SR} h ${n.w - 2 * SR} a ${SR} ${SR} 0 0 1 ${SR} ${SR} v ${HEAD - SR} h ${-n.w} z`}
              class="source-head"
            />
            <g transform={`translate(${n.x + 8}, ${n.y + 6}) scale(0.75)`} class="source-icon">
              <path d={iconFor("Field") ?? ""} />
            </g>
            <text x={n.x + 24} y={n.y + 12} class="source-verb">{n.title ?? n.verb}</text>
            <text x={n.x + 24} y={n.y + 21} class="source-sub">Table</text>
            <text x={n.x + n.w - 9} y={n.y + 16} text-anchor="end" class="source-badge">source</text>
            {/* column header */}
            <rect x={n.x + 0.5} y={n.y + HEAD} width={n.w - 1} height={ROW} class="sheet-head" />
            <text x={n.x + 12} y={n.y + HEAD + 10.5} text-anchor="middle" class="sheet-num">#</text>
            {n.table.columns.map((c, ci) => (
              <text x={tableColX(n, ci)} y={n.y + HEAD + 10.5} class="sheet-col">{c}</text>
            ))}
            <line x1={n.x + 20} y1={n.y + HEAD} x2={n.x + 20} y2={n.y + n.h - 6} class="sheet-rule" />
            {n.table.columns.slice(1).map((_, ci) => (
              <line x1={tableColX(n, ci + 1) - 5} y1={n.y + HEAD} x2={tableColX(n, ci + 1) - 5} y2={n.y + n.h - 6} class="sheet-rule" />
            ))}
            {n.table.rows.map((r, ri) => (
              <g>
                <line x1={n.x + 0.5} y1={n.y + HEAD + ROW * (ri + 1)} x2={n.x + n.w - 0.5} y2={n.y + HEAD + ROW * (ri + 1)} class="sheet-rule" />
                <text x={n.x + 12} y={n.y + HEAD + ROW * (ri + 1) + 10.5} text-anchor="middle" class="sheet-num">{ri + 1}</text>
                {r.map((cell, ci) => (
                  <text x={tableColX(n, ci)} y={n.y + HEAD + ROW * (ri + 1) + 10.5} class="sheet-cell">{cell}</text>
                ))}
              </g>
            ))}
            {n.table.total && n.table.total > n.table.rows.length && (
              <text x={n.x + n.w - 9} y={n.y + n.h - 2.5} text-anchor="end" class="sheet-more">{n.table.total} rows</text>
            )}
            {(n.kind !== "source" || hasInput.has(n.id)) && <circle cx={n.x} cy={n.cy} r="5" class="port" />}
            <circle cx={n.x + n.w} cy={n.cy} r="5" class="port" />
          </g>
        ) : n.kind === "gate" ? (
          <g class="node gate kind-gate" style={`--tint: ${tint(n)}; --i: ${n.col}`}>
            <path
              d={`M ${n.x + CH} ${n.y} H ${n.x + n.w - CH} L ${n.x + n.w} ${n.cy} L ${n.x + n.w - CH} ${n.y + n.h} H ${n.x + CH} L ${n.x} ${n.cy} Z`}
              class="gate-body"
            />
            {isBareGate(n) ? (
              <>
                <g transform={`translate(${n.x + CH + 2}, ${n.cy - 6}) scale(0.75)`} class="gate-icon">
                  <path d={iconFor(n.verb) ?? ""} />
                </g>
                <text x={n.x + CH + 18} y={n.cy + 4} class="gate-verb">
                  {n.verb}
                </text>
              </>
            ) : (
              <>
                <g transform={`translate(${n.x + CH + 2}, ${n.y + 6}) scale(0.75)`} class="gate-icon">
                  <path d={iconFor(n.verb) ?? ""} />
                </g>
                <text x={n.x + CH + 18} y={n.y + 16} class="gate-verb">
                  {n.verb}
                </text>
              </>
            )}
            {n.mode && (
              <text x={n.x + n.w - CH - 2} y={n.y + 16} text-anchor="end" class="gate-badge">
                {n.mode}
              </text>
            )}
            {n.title && (
              <text x={n.x + CH + 2} y={n.y + HEAD + 19} class="card-title">
                {n.title}
              </text>
            )}
            <circle cx={n.x} cy={n.cy} r="5" class="port" />
            <circle cx={n.x + n.w} cy={n.cy} r="5" class="port" />
            <circle cx={n.x + n.w - CH} cy={n.y + n.h - 1} r="3.5" class="port-error" />
          </g>
        ) : n.kind === "source" ? (
          <g class="node source kind-source" style={`--tint: ${tint(n)}; --i: ${n.col}`}>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx={SR} class="source-body" />
            <path
              d={`M ${n.x} ${n.y + SR} a ${SR} ${SR} 0 0 1 ${SR} ${-SR} h ${n.w - 2 * SR} a ${SR} ${SR} 0 0 1 ${SR} ${SR} v ${HEAD - SR} h ${-n.w} z`}
              class="source-head"
            />
            <g transform={`translate(${n.x + 8}, ${n.y + 6}) scale(0.75)`} class="source-icon">
              <path d={iconFor(n.verb) ?? ""} />
            </g>
            <text x={n.x + 24} y={n.y + 16} class="source-verb">
              {n.verb}
            </text>
            {n.mode && (
              <text x={n.x + n.w - 9} y={n.y + 16} text-anchor="end" class="source-badge">
                {n.mode}
              </text>
            )}
            {n.query ? (
              <text x={n.x + 9} y={n.y + HEAD + 19} class="card-query">
                {n.query}
              </text>
            ) : (
              <text x={n.x + 9} y={n.y + HEAD + 19} class="card-title">
                {n.title ?? ""}
              </text>
            )}
            {hasInput.has(n.id) && <circle cx={n.x} cy={n.cy} r="5" class="port" />}
            <circle cx={n.x + n.w} cy={n.cy} r="5" class="port" />
          </g>
        ) : (
          <g class={`node card kind-${n.kind}`} style={`--tint: ${tint(n)}; --i: ${n.col}`}>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="8" class="card-body" />
            <path
              d={`M ${n.x} ${n.y + 8} a 8 8 0 0 1 8 -8 h ${n.w - 16} a 8 8 0 0 1 8 8 v ${HEAD - 8} h ${-n.w} z`}
              class="card-head"
            />
            <g transform={`translate(${n.x + 8}, ${n.y + 6}) scale(0.75)`} class="card-icon">
              <path d={iconFor(n.verb) ?? ""} />
            </g>
            <text x={n.x + 24} y={n.y + 16} class="card-verb">
              {n.verb}
            </text>
            {(n.kind === "block" || n.kind === "agent") && (
              <g>
                <circle cx={n.x + n.w - dotInset(n)} cy={n.y + 12} r="3" class="model-dot-glow" filter={`url(#glow-${flow.id})`} />
                <circle cx={n.x + n.w - dotInset(n)} cy={n.y + 12} r="2.2" class="model-dot" />
              </g>
            )}
            {n.mode && (
              <text x={n.x + n.w - 9} y={n.y + 16} text-anchor="end" class="card-badge">
                {n.mode}
              </text>
            )}
            {(n.query || n.title) && (
              <text x={n.x + 9} y={n.y + HEAD + 19} class={n.query ? "card-query" : "card-title"}>
                {n.query ?? n.title}
              </text>
            )}
            {(n.kind !== "source" || hasInput.has(n.id)) && <circle cx={n.x} cy={n.cy} r="5" class="port" />}
            {n.kind !== "egress" && <circle cx={n.x + n.w} cy={n.cy} r="5" class="port" />}
            {n.kind !== "source" && !isBareEgress(n) && <circle cx={n.x + n.w} cy={n.y + n.h - 9} r="3.5" class="port-error" />}
          </g>
        ),
      )}
    </svg>
  </div>
  {(caption || legend) && (
    <figcaption>
      {caption && <span class="cap">{caption}</span>}
      {legend && (
        <span class="legend" aria-label="Wire origins">
          {origins.map((o) => (
            <span class={`key origin-${o}`}>
              <i aria-hidden="true" />
              {originLabel[o]}
            </span>
          ))}
        </span>
      )}
    </figcaption>
  )}
</figure>

