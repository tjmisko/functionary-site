---
import { kindCategory, extractionTint, originLabel } from "../lib/flow";
import { iconFor } from "../lib/icons";
import type { CanvasFlow, CanvasNode } from "../lib/canvas";

/**
 * A static drawing of a flow in the product's canvas grammar.
 *
 * Taken from the app's stylesheet: a card is a 1px rgba(255,255,255,.12)
 * border on rgba(28,33,40,.95) with an 8px radius and a kind-coloured header
 * carrying a line icon, the verb and a badge; a Transform is a quiet grey
 * pill; a Jig is a translucent orange region that holds its body, with a
 * label above and a footer below; ports are 10px rings on the card edge and
 * every non-source card has a small error port at its lower right. A block
 * that calls a model carries a glowing white dot in its header.
 *
 * Wires carry the origin axis: Sourced and Computed plain, Generated dashed,
 * Verified and Reviewed tinted. `run` plays one pass of execution state left
 * to right, once, and freezes on the finished state under reduced motion.
 */

interface Props {
  flow: CanvasFlow;
  caption?: string;
  legend?: boolean;
  run?: boolean;
  width?: number;
  /** Drawn inside a Workspace frame: no border of its own. */
  bare?: boolean;
}

const { flow, caption, legend = false, run = false, width: NW = 156, bare = false } = Astro.props;

const NH_CARD = 54;
const HEAD = 24;
const NH_PILL = 34;
const GAP_X = 46;
const PITCH_Y = 80;
const PAD = 20;
const JIG_PAD = 14;
const JIG_HEAD = 24;
const JIG_FOOT = 18;

function heightOf(n: CanvasNode) {
  return n.kind === "transform" ? NH_PILL : NH_CARD;
}

const maxCol = Math.max(...flow.nodes.map((n) => n.col));
const maxLane = Math.max(...flow.nodes.map((n) => n.lane));
const hasJig = flow.nodes.some((n) => n.kind === "jig");

type Placed = CanvasNode & { x: number; y: number; w: number; h: number; cx: number; cy: number };

const placed: Placed[] = flow.nodes
  .filter((n) => n.kind !== "jig")
  .map((n) => {
    const h = heightOf(n);
    const x = PAD + n.col * (NW + GAP_X);
    const y = PAD + (hasJig ? JIG_HEAD : 0) + n.lane * PITCH_Y + (NH_CARD - h) / 2;
    return { ...n, x, y, w: NW, h, cx: x + NW / 2, cy: y + h / 2 };
  });

const byId = new Map(placed.map((p) => [p.id, p]));

const jigs = flow.nodes
  .filter((n) => n.kind === "jig")
  .map((j) => {
    const members = (j.body ?? []).map((id) => byId.get(id)!).filter(Boolean);
    const x0 = Math.min(...members.map((m) => m.x)) - JIG_PAD;
    const x1 = Math.max(...members.map((m) => m.x + m.w)) + JIG_PAD;
    const y0 = Math.min(...members.map((m) => m.y)) - JIG_PAD - JIG_HEAD;
    const y1 = Math.max(...members.map((m) => m.y + m.h)) + JIG_PAD + (j.foot ? JIG_FOOT : 0);
    return { ...j, x: x0, y: y0, w: x1 - x0, h: y1 - y0 };
  });

const vw = PAD * 2 + (maxCol + 1) * NW + maxCol * GAP_X;
const vh = PAD * 2 + (hasJig ? JIG_HEAD + JIG_FOOT : 0) + maxLane * PITCH_Y + NH_CARD;

const edges = flow.edges.map((e, i) => {
  const a = byId.get(e.from)!;
  const b = byId.get(e.to)!;
  const x1 = a.x + a.w + 5;
  const y1 = a.cy;
  const x2 = b.x - 5;
  const y2 = b.cy;
  const dx = Math.max(24, (x2 - x1) * 0.5);
  const d = `M ${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`;
  const mx = (x1 + x2) / 2;
  const my = (y1 + y2) / 2;
  const label = x2 - x1 >= 40 || Math.abs(y2 - y1) > 20 ? e.label : undefined;
  return { ...e, label, id: `${flow.id}-e${i}`, d, mx, my, origin: e.origin ?? "computed", col: a.col };
});

function tint(n: CanvasNode) {
  if (n.kind === "block" && n.extraction) return extractionTint;
  return kindCategory[n.kind];
}

const origins = Array.from(new Set(edges.map((e) => e.origin)));
const minWidth = Math.round(vw * 0.72);
---

<figure class:list={["canvas", { run, bare }]} style={`--min-w: ${minWidth}px`}>
  <div class="stage">
    <svg viewBox={`0 0 ${vw} ${vh}`} role="img" aria-label={flow.aria} preserveAspectRatio="xMidYMid meet">
      <defs>
        <pattern id={`grid-${flow.id}`} width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="1" class="grid-dot" />
        </pattern>
        <filter id={`glow-${flow.id}`} x="-100%" y="-100%" width="300%" height="300%">
          <feGaussianBlur stdDeviation="1.6" />
        </filter>
      </defs>
      <rect x="0" y="0" width={vw} height={vh} fill={`url(#grid-${flow.id})`} />

      {jigs.map((j) => (
        <g class="jig">
          <rect x={j.x} y={j.y} width={j.w} height={j.h} rx="10" class="jig-region" />
          <g transform={`translate(${j.x + 10}, ${j.y + 7}) scale(0.68)`} class="jig-icon">
            <path d={iconFor(j.verb) ?? ""} />
          </g>
          <text x={j.x + 25} y={j.y + 16} class="jig-label">
            {j.verb.toUpperCase()}
            {j.mode && <tspan class="jig-mode"> {j.mode}</tspan>}
          </text>
          {j.foot && (
            <text x={j.x + j.w - 10} y={j.y + j.h - 7} text-anchor="end" class="jig-foot">
              {j.foot}
            </text>
          )}
        </g>
      ))}

      {edges.map((e) => (
        <g class={`edge origin-${e.origin}`} style={`--i: ${e.col}`}>
          <path d={e.d} class="wire" />
          {run && <path d={e.d} class="wire-run" />}
          {e.label && (
            <text x={e.mx} y={e.my - 6} text-anchor="middle" class="wire-label">
              {e.label}
            </text>
          )}
        </g>
      ))}

      {placed.map((n) =>
        n.kind === "transform" ? (
          <g class="node pill" style={`--tint: ${tint(n)}; --i: ${n.col}`}>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx={n.h / 2} class="pill-body" />
            <circle cx={n.x} cy={n.cy} r="5" class="port" />
            <circle cx={n.x + n.w} cy={n.cy} r="5" class="port" />
            <g transform={`translate(${n.x + 12}, ${n.cy - 6}) scale(0.75)`} class="pill-icon">
              <path d={iconFor(n.verb) ?? ""} />
            </g>
            <text x={n.x + 28} y={n.cy + (n.mode ? -1 : 4)} class="pill-verb">
              {n.verb}
            </text>
            {n.mode && (
              <text x={n.x + 28} y={n.cy + 11} class="pill-mode">
                {n.mode}
              </text>
            )}
          </g>
        ) : (
          <g class={`node card kind-${n.kind}`} style={`--tint: ${tint(n)}; --i: ${n.col}`}>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="8" class="card-body" />
            <path
              d={`M ${n.x} ${n.y + 8} a 8 8 0 0 1 8 -8 h ${n.w - 16} a 8 8 0 0 1 8 8 v ${HEAD - 8} h ${-n.w} z`}
              class="card-head"
            />
            <g transform={`translate(${n.x + 8}, ${n.y + 6}) scale(0.75)`} class="card-icon">
              <path d={iconFor(n.verb) ?? ""} />
            </g>
            <text x={n.x + 24} y={n.y + 16} class="card-verb">
              {n.verb}
            </text>
            {(n.kind === "block" || n.kind === "agent") && (
              <g>
                <circle cx={n.x + n.w - (n.mode ? 46 : 12)} cy={n.y + 12} r="3" class="model-dot-glow" filter={`url(#glow-${flow.id})`} />
                <circle cx={n.x + n.w - (n.mode ? 46 : 12)} cy={n.y + 12} r="2.2" class="model-dot" />
              </g>
            )}
            {n.mode && (
              <text x={n.x + n.w - 9} y={n.y + 16} text-anchor="end" class="card-badge">
                {n.mode}
              </text>
            )}
            <text x={n.x + 9} y={n.y + HEAD + 19} class="card-title">
              {n.title ?? ""}
            </text>
            {run && n.kind === "gate" && (
              <text x={n.x + n.w - 9} y={n.y + 16} text-anchor="end" class="card-state">
                awaiting review
              </text>
            )}
            {n.kind !== "source" && <circle cx={n.x} cy={n.cy} r="5" class="port" />}
            {n.kind !== "egress" && <circle cx={n.x + n.w} cy={n.cy} r="5" class="port" />}
            {n.kind !== "source" && <circle cx={n.x + n.w} cy={n.y + n.h - 9} r="3.5" class="port-error" />}
          </g>
        ),
      )}
    </svg>
  </div>
  {(caption || legend) && (
    <figcaption>
      {caption && <span class="cap">{caption}</span>}
      {legend && (
        <span class="legend" aria-label="Wire origins">
          {origins.map((o) => (
            <span class={`key origin-${o}`}>
              <i aria-hidden="true" />
              {originLabel[o]}
            </span>
          ))}
        </span>
      )}
    </figcaption>
  )}
</figure>

<style>
  .canvas {
    margin: 0;
    min-width: 0;
  }
  .stage {
    background: var(--bg-0);
    border: 1px solid var(--border-0);
    border-radius: var(--r-10);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .bare .stage {
    border: 0;
    border-radius: 0;
  }
  .stage::-webkit-scrollbar {
    display: none;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  @media (max-width: 1100px) {
    svg {
      min-width: var(--min-w);
    }
  }
  .grid-dot {
    fill: rgba(230, 233, 238, 0.07);
  }

  .card-body {
    fill: rgba(28, 33, 40, 0.97);
    stroke: rgba(255, 255, 255, 0.12);
    stroke-width: 1;
  }
  .card-head {
    fill: var(--tint);
    opacity: 0.92;
  }
  .card-icon path,
  .pill-icon path,
  .jig-icon path {
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .card-icon path {
    stroke: #fff;
  }
  .kind-gate .card-icon path {
    stroke: #1f1b0a;
  }
  .pill-icon path {
    stroke: var(--fg-1);
  }
  .jig-icon path {
    stroke: #e8bd68;
  }
  .card-verb {
    fill: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
  }
  .card-badge {
    fill: rgba(255, 255, 255, 0.78);
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .kind-gate .card-verb,
  .kind-gate .card-badge {
    fill: #1f1b0a;
  }
  .model-dot {
    fill: #fff;
  }
  .model-dot-glow {
    fill: rgba(255, 255, 255, 0.9);
  }
  .card-title {
    fill: #b8bec7;
    font-family: var(--font-ui);
    font-size: 10.5px;
  }
  .card-state {
    fill: #1f1b0a;
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    opacity: 0;
  }

  .pill-body {
    fill: var(--bg-3);
    stroke: var(--border-1);
    stroke-width: 1;
  }
  .pill-verb {
    fill: var(--fg-0);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
  }
  .pill-mode {
    fill: var(--fg-2);
    font-family: var(--font-mono);
    font-size: 8px;
  }

  .jig-region {
    fill: rgba(217, 164, 65, 0.07);
    stroke: color-mix(in srgb, var(--cat-control) 65%, transparent);
    stroke-width: 1.5;
  }
  .jig-label {
    fill: #e8bd68;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
  }
  .jig-mode {
    fill: rgba(232, 189, 104, 0.7);
    font-weight: 400;
    letter-spacing: 0;
  }
  .jig-foot {
    fill: rgba(207, 165, 86, 0.9);
    font-family: var(--font-mono);
    font-size: 8px;
  }

  .port {
    fill: rgba(28, 33, 40, 0.95);
    stroke: rgba(255, 255, 255, 0.3);
    stroke-width: 2;
  }
  .port-error {
    fill: rgba(28, 33, 40, 0.95);
    stroke: rgba(220, 80, 80, 0.5);
    stroke-width: 1.5;
  }

  .wire {
    fill: none;
    stroke: var(--border-1);
    stroke-width: 1.6;
  }
  .wire-label {
    fill: var(--fg-3);
    font-family: var(--font-mono);
    font-size: 7.5px;
  }
  .origin-sourced .wire {
    stroke: color-mix(in srgb, var(--cat-source) 55%, var(--border-1));
  }
  .origin-generated .wire {
    stroke: color-mix(in srgb, var(--cat-synthesis) 70%, var(--border-1));
    stroke-dasharray: 4 4;
  }
  .origin-verified .wire {
    stroke: var(--success);
  }
  .origin-reviewed .wire {
    stroke: var(--cat-human);
  }

  /* one pass of execution state, left to right */
  .run .card-body,
  .run .pill-body {
    animation: step 1.1s ease forwards;
    animation-delay: calc(var(--i) * 0.55s + 0.6s);
  }
  .run .kind-gate .card-body {
    animation-name: gate;
  }
  .run .kind-egress .card-body {
    animation: none;
  }
  .wire-run {
    fill: none;
    stroke: #6aa681;
    stroke-width: 1.6;
    opacity: 0;
    animation: show 0.5s ease forwards;
    animation-delay: calc(var(--i) * 0.55s + 1.5s);
  }
  .run .card-state {
    animation: show 0.3s ease forwards;
    animation-delay: calc(var(--i) * 0.55s + 1.7s);
  }
  @keyframes step {
    0% {
      stroke: rgba(255, 255, 255, 0.12);
    }
    35% {
      stroke: rgba(176, 188, 204, 0.9);
      stroke-width: 1.5;
    }
    100% {
      stroke: #6aa681;
      stroke-width: 1;
    }
  }
  @keyframes gate {
    0% {
      stroke: rgba(255, 255, 255, 0.12);
    }
    35% {
      stroke: rgba(176, 188, 204, 0.9);
    }
    100% {
      stroke: var(--conf-needs-input);
    }
  }
  @keyframes show {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .run .card-body,
    .run .pill-body,
    .wire-run,
    .run .card-state {
      animation-duration: 0.001ms;
      animation-delay: 0s;
    }
  }

  figcaption {
    margin-top: var(--s-12);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-8) var(--s-20);
    font-size: var(--ms-small);
    color: var(--fg-2);
  }
  .legend {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--s-12);
    font-family: var(--font-mono);
    font-size: var(--fs-10);
    color: var(--fg-2);
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .key i {
    display: inline-block;
    width: 18px;
    height: 0;
    border-top: 1.5px solid var(--border-1);
  }
  .key.origin-sourced i {
    border-color: color-mix(in srgb, var(--cat-source) 55%, var(--border-1));
  }
  .key.origin-generated i {
    border-top-style: dashed;
    border-color: color-mix(in srgb, var(--cat-synthesis) 70%, var(--border-1));
  }
  .key.origin-verified i {
    border-color: var(--success);
  }
  .key.origin-reviewed i {
    border-color: var(--cat-human);
  }
</style>
