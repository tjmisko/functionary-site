---
import { kindCategory, extractionTint, originLabel } from "../lib/flow";
import { iconFor } from "../lib/icons";
import type { CanvasFlow, CanvasNode } from "../lib/canvas";

/**
 * A static drawing of a flow in the product's canvas grammar.
 *
 * Taken from the app's stylesheet: a card is a 1px rgba(255,255,255,.12)
 * border on rgba(28,33,40,.95) with an 8px radius and a kind-coloured header
 * carrying a line icon, the verb and a badge; a Transform is a quiet grey
 * pill; a Jig is a translucent orange region that holds its body, with a
 * label above and a footer below; ports are 10px rings on the card edge and
 * every non-source card has a small error port at its lower right. A block
 * that calls a model carries a glowing white dot in its header. A table
 * source is drawn as the product draws one: a wider card whose body is the
 * spreadsheet, with a row-number column and 1px row rules.
 *
 * Wires carry the origin axis: Sourced and Computed plain, Generated dashed,
 * Verified and Reviewed tinted. A wire's type appears on hover. `run` plays
 * one pass of execution state left to right, once, and freezes on the
 * finished state under reduced motion.
 */

interface Props {
  flow: CanvasFlow;
  caption?: string;
  legend?: boolean;
  run?: boolean;
  width?: number;
  /** Drawn on the page itself: no border, no grid. */
  bare?: boolean;
}

const { flow, caption, legend = false, run = false, width: NW = 136, bare = false } = Astro.props;

const NH_CARD = 54;
const HEAD = 24;
const NH_PILL = 34;
const TW = 212;
const ROW = 15;
const GAP_X = 22;
const PITCH_Y = 80;
const PAD = 12;
const JIG_PAD = 14;
const JIG_HEAD = 24;
const JIG_FOOT = 18;

function widthOf(n: CanvasNode) {
  return n.table ? TW : NW;
}
function heightOf(n: CanvasNode) {
  if (n.table) return HEAD + ROW + n.table.rows.length * ROW + 8;
  return n.kind === "transform" ? NH_PILL : NH_CARD;
}

const maxCol = Math.max(...flow.nodes.map((n) => n.col));
const hasJig = flow.nodes.some((n) => n.kind === "jig");

// Column widths: a column is as wide as its widest node.
const colW: number[] = [];
for (let c = 0; c <= maxCol; c++) {
  const inCol = flow.nodes.filter((n) => n.kind !== "jig" && n.col === c);
  colW[c] = inCol.length ? Math.max(...inCol.map(widthOf)) : NW;
}
const colX: number[] = [];
let acc = PAD;
for (let c = 0; c <= maxCol; c++) {
  colX[c] = acc;
  acc += colW[c] + GAP_X;
}

type Placed = CanvasNode & { x: number; y: number; w: number; h: number; cx: number; cy: number };

const topY = PAD + (hasJig ? JIG_HEAD : 0);
let placed: Placed[] = flow.nodes
  .filter((n) => n.kind !== "jig")
  .map((n) => {
    const w = widthOf(n);
    const h = heightOf(n);
    const x = colX[n.col] + (colW[n.col] - w) / 2;
    const cy = topY + n.lane * PITCH_Y + NH_CARD / 2;
    const y = cy - h / 2;
    return { ...n, x, y, w, h, cx: x + w / 2, cy };
  });

let byId = new Map(placed.map((p) => [p.id, p]));

function placeJigs(nodes: Placed[]) {
  const map = new Map(nodes.map((p) => [p.id, p]));
  return flow.nodes
    .filter((n) => n.kind === "jig")
    .map((j) => {
      const members = (j.body ?? []).map((id) => map.get(id)!).filter(Boolean);
      const x0 = Math.min(...members.map((m) => m.x)) - JIG_PAD;
      const x1 = Math.max(...members.map((m) => m.x + m.w)) + JIG_PAD;
      const y0 = Math.min(...members.map((m) => m.y)) - JIG_PAD - JIG_HEAD;
      const y1 = Math.max(...members.map((m) => m.y + m.h)) + JIG_PAD + (j.foot ? JIG_FOOT : 0);
      return { ...j, x: x0, y: y0, w: x1 - x0, h: y1 - y0 };
    });
}

// A tall card can poke above the first lane; shift everything so the
// drawing starts at PAD.
let jigs = placeJigs(placed);
const minTop = Math.min(...placed.map((p) => p.y), ...jigs.map((j) => j.y));
const shift = PAD - minTop;
if (shift !== 0) {
  placed = placed.map((p) => ({ ...p, y: p.y + shift, cy: p.cy + shift }));
  byId = new Map(placed.map((p) => [p.id, p]));
  jigs = placeJigs(placed);
}

const vw = acc - GAP_X + PAD;
const vh = Math.max(...placed.map((p) => p.y + p.h), ...jigs.map((j) => j.y + j.h)) + PAD;

const edges = flow.edges.map((e, i) => {
  const a = byId.get(e.from)!;
  const b = byId.get(e.to)!;
  const x1 = a.x + a.w + 5;
  const y1 = a.cy;
  const x2 = b.x - 5;
  const y2 = b.cy;
  const dx = Math.max(24, (x2 - x1) * 0.5);
  const d = `M ${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`;
  const mx = (x1 + x2) / 2;
  const my = (y1 + y2) / 2;
  return { ...e, id: `${flow.id}-e${i}`, d, mx, my, origin: e.origin ?? "computed", col: a.col };
});

function tableColX(n: Placed, ci: number) {
  const ws = n.table!.widths ?? n.table!.columns.map(() => 1);
  const total = ws.reduce((a, b) => a + b, 0);
  const avail = n.w - 26;
  let off = 0;
  for (let i = 0; i < ci; i++) off += (avail * ws[i]) / total;
  return n.x + 22 + off;
}

function tint(n: CanvasNode) {
  if (n.kind === "block" && n.extraction) return extractionTint;
  return kindCategory[n.kind];
}

const origins = Array.from(new Set(edges.map((e) => e.origin)));
const minWidth = Math.round(vw * 0.72);
---

<figure class:list={["canvas", { run, bare }]} style={`--min-w: ${minWidth}px`}>
  <div class="stage">
    <svg viewBox={`0 0 ${vw} ${vh}`} role="img" aria-label={flow.aria} preserveAspectRatio="xMidYMid meet">
      <defs>
        <pattern id={`grid-${flow.id}`} width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="1" class="grid-dot" />
        </pattern>
        <filter id={`glow-${flow.id}`} x="-100%" y="-100%" width="300%" height="300%">
          <feGaussianBlur stdDeviation="1.6" />
        </filter>
      </defs>
      {!bare && <rect x="0" y="0" width={vw} height={vh} fill={`url(#grid-${flow.id})`} />}

      {jigs.map((j) => (
        <g class="jig">
          <rect x={j.x} y={j.y} width={j.w} height={j.h} rx="10" class="jig-region" />
          <g transform={`translate(${j.x + 10}, ${j.y + 7}) scale(0.68)`} class="jig-icon">
            <path d={iconFor(j.verb) ?? ""} />
          </g>
          <text x={j.x + 25} y={j.y + 16} class="jig-label">
            {j.verb.toUpperCase()}
            {j.mode && <tspan class="jig-mode"> {j.mode}</tspan>}
          </text>
          {j.foot && (
            <text x={j.x + j.w - 10} y={j.y + j.h - 7} text-anchor="end" class="jig-foot">
              {j.foot}
            </text>
          )}
        </g>
      ))}

      {edges.map((e) => (
        <g class={`edge origin-${e.origin}`} style={`--i: ${e.col}`}>
          <path d={e.d} class="wire" />
          {run && <path d={e.d} class="wire-run" />}
          <path d={e.d} class="wire-hit" />
          {e.label && (
            <g class="wire-tip">
              <rect x={e.mx - e.label.length * 3.1 - 6} y={e.my - 19} width={e.label.length * 6.2 + 12} height="15" rx="3" class="tip-bg" />
              <text x={e.mx} y={e.my - 8.5} text-anchor="middle" class="wire-label">
                {e.label}
              </text>
            </g>
          )}
        </g>
      ))}

      {placed.map((n) =>
        n.kind === "transform" ? (
          <g class="node pill" style={`--tint: ${tint(n)}; --i: ${n.col}`}>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx={n.h / 2} class="pill-body" />
            <circle cx={n.x} cy={n.cy} r="5" class="port" />
            <circle cx={n.x + n.w} cy={n.cy} r="5" class="port" />
            <g transform={`translate(${n.x + 12}, ${n.cy - 6}) scale(0.75)`} class="pill-icon">
              <path d={iconFor(n.verb) ?? ""} />
            </g>
            <text x={n.x + 28} y={n.cy + (n.mode ? -1 : 4)} class="pill-verb">
              {n.verb}
            </text>
            {n.mode && (
              <text x={n.x + 28} y={n.cy + 11} class="pill-mode">
                {n.mode}
              </text>
            )}
          </g>
        ) : n.table ? (
          <g class={`node card table kind-${n.kind}`} style={`--tint: ${tint(n)}; --i: ${n.col}`}>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="8" class="card-body" />
            <path
              d={`M ${n.x} ${n.y + 8} a 8 8 0 0 1 8 -8 h ${n.w - 16} a 8 8 0 0 1 8 8 v ${HEAD - 8} h ${-n.w} z`}
              class="card-head"
            />
            <text x={n.x + 9} y={n.y + 15} class="card-tri">▶</text>
            <text x={n.x + 20} y={n.y + 12} class="card-verb">{n.title ?? n.verb}</text>
            <text x={n.x + 20} y={n.y + 21} class="card-sub">Table</text>
            <text x={n.x + n.w - 9} y={n.y + 16} text-anchor="end" class="card-badge">source</text>
            {/* column header */}
            <rect x={n.x + 0.5} y={n.y + HEAD} width={n.w - 1} height={ROW} class="sheet-head" />
            <text x={n.x + 10} y={n.y + HEAD + 10.5} text-anchor="middle" class="sheet-num">#</text>
            {n.table.columns.map((c, ci) => (
              <text x={tableColX(n, ci)} y={n.y + HEAD + 10.5} class="sheet-col">{c}</text>
            ))}
            <line x1={n.x + 18} y1={n.y + HEAD} x2={n.x + 18} y2={n.y + n.h - 6} class="sheet-rule" />
            {n.table.columns.slice(1).map((_, ci) => (
              <line x1={tableColX(n, ci + 1) - 5} y1={n.y + HEAD} x2={tableColX(n, ci + 1) - 5} y2={n.y + n.h - 6} class="sheet-rule" />
            ))}
            {n.table.rows.map((r, ri) => (
              <g>
                <line x1={n.x + 0.5} y1={n.y + HEAD + ROW * (ri + 1)} x2={n.x + n.w - 0.5} y2={n.y + HEAD + ROW * (ri + 1)} class="sheet-rule" />
                <text x={n.x + 10} y={n.y + HEAD + ROW * (ri + 1) + 10.5} text-anchor="middle" class="sheet-num">{ri + 1}</text>
                {r.map((cell, ci) => (
                  <text x={tableColX(n, ci)} y={n.y + HEAD + ROW * (ri + 1) + 10.5} class="sheet-cell">{cell}</text>
                ))}
              </g>
            ))}
            {n.table.total && n.table.total > n.table.rows.length && (
              <text x={n.x + n.w - 9} y={n.y + n.h - 2.5} text-anchor="end" class="sheet-more">{n.table.total} rows</text>
            )}
            {n.kind !== "source" && <circle cx={n.x} cy={n.cy} r="5" class="port" />}
            <circle cx={n.x + n.w} cy={n.cy} r="5" class="port" />
          </g>
        ) : (
          <g class={`node card kind-${n.kind}`} style={`--tint: ${tint(n)}; --i: ${n.col}`}>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="8" class="card-body" />
            <path
              d={`M ${n.x} ${n.y + 8} a 8 8 0 0 1 8 -8 h ${n.w - 16} a 8 8 0 0 1 8 8 v ${HEAD - 8} h ${-n.w} z`}
              class="card-head"
            />
            <g transform={`translate(${n.x + 8}, ${n.y + 6}) scale(0.75)`} class="card-icon">
              <path d={iconFor(n.verb) ?? ""} />
            </g>
            <text x={n.x + 24} y={n.y + 16} class="card-verb">
              {n.verb}
            </text>
            {(n.kind === "block" || n.kind === "agent") && (
              <g>
                <circle cx={n.x + n.w - (n.mode ? 46 : 12)} cy={n.y + 12} r="3" class="model-dot-glow" filter={`url(#glow-${flow.id})`} />
                <circle cx={n.x + n.w - (n.mode ? 46 : 12)} cy={n.y + 12} r="2.2" class="model-dot" />
              </g>
            )}
            {n.mode && (
              <text x={n.x + n.w - 9} y={n.y + 16} text-anchor="end" class="card-badge">
                {n.mode}
              </text>
            )}
            <text x={n.x + 9} y={n.y + HEAD + 19} class="card-title">
              {n.title ?? ""}
            </text>
            {run && n.kind === "gate" && (
              <text x={n.x + n.w - 9} y={n.y + 16} text-anchor="end" class="card-state">
                parked
              </text>
            )}
            {n.kind !== "source" && <circle cx={n.x} cy={n.cy} r="5" class="port" />}
            {n.kind !== "egress" && <circle cx={n.x + n.w} cy={n.cy} r="5" class="port" />}
            {n.kind !== "source" && <circle cx={n.x + n.w} cy={n.y + n.h - 9} r="3.5" class="port-error" />}
          </g>
        ),
      )}
    </svg>
  </div>
  {(caption || legend) && (
    <figcaption>
      {caption && <span class="cap">{caption}</span>}
      {legend && (
        <span class="legend" aria-label="Wire origins">
          {origins.map((o) => (
            <span class={`key origin-${o}`}>
              <i aria-hidden="true" />
              {originLabel[o]}
            </span>
          ))}
        </span>
      )}
    </figcaption>
  )}
</figure>

<style>
  .canvas {
    margin: 0;
    min-width: 0;
  }
  .stage {
    background: var(--bg-0);
    border: 1px solid var(--border-0);
    border-radius: var(--r-10);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .bare .stage {
    border: 0;
    border-radius: 0;
  }
  .stage::-webkit-scrollbar {
    display: none;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  @media (max-width: 1100px) {
    svg {
      min-width: var(--min-w);
    }
  }
  .grid-dot {
    fill: rgba(230, 233, 238, 0.07);
  }

  .card-body {
    fill: rgba(28, 33, 40, 0.97);
    stroke: rgba(255, 255, 255, 0.12);
    stroke-width: 1;
  }
  .card-head {
    fill: var(--tint);
    opacity: 0.92;
  }
  .card-icon path,
  .pill-icon path,
  .jig-icon path {
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .card-icon path {
    stroke: #fff;
  }
  .kind-gate .card-icon path {
    stroke: #1f1b0a;
  }
  .pill-icon path {
    stroke: var(--fg-1);
  }
  .jig-icon path {
    stroke: #e8bd68;
  }
  .card-verb {
    fill: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
  }
  .card-tri {
    fill: rgba(255, 255, 255, 0.9);
    font-size: 7px;
  }
  .card-sub {
    fill: rgba(255, 255, 255, 0.7);
    font-family: var(--font-mono);
    font-size: 7px;
  }
  .card-badge {
    fill: rgba(255, 255, 255, 0.78);
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .kind-gate .card-verb,
  .kind-gate .card-badge {
    fill: #1f1b0a;
  }
  .model-dot {
    fill: #fff;
  }
  .model-dot-glow {
    fill: rgba(255, 255, 255, 0.9);
  }
  .card-title {
    fill: #b8bec7;
    font-family: var(--font-ui);
    font-size: 10.5px;
  }
  .card-state {
    fill: #1f1b0a;
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    opacity: 0;
  }

  /* the spreadsheet body of a table source */
  .sheet-head {
    fill: rgba(18, 22, 28, 0.55);
  }
  .sheet-rule {
    stroke: var(--border-0);
    stroke-width: 1;
  }
  .sheet-num {
    fill: var(--fg-3);
    font-family: var(--font-mono);
    font-size: 7.5px;
  }
  .sheet-col {
    fill: var(--fg-1);
    font-family: var(--font-mono);
    font-size: 8px;
  }
  .sheet-cell {
    fill: var(--fg-0);
    font-family: var(--font-mono);
    font-size: 8px;
  }
  .sheet-more {
    fill: var(--fg-3);
    font-family: var(--font-mono);
    font-size: 7px;
  }

  .pill-body {
    fill: var(--bg-3);
    stroke: var(--border-1);
    stroke-width: 1;
  }
  .pill-verb {
    fill: var(--fg-0);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
  }
  .pill-mode {
    fill: var(--fg-2);
    font-family: var(--font-mono);
    font-size: 8px;
  }

  .jig-region {
    fill: rgba(217, 164, 65, 0.07);
    stroke: color-mix(in srgb, var(--cat-control) 65%, transparent);
    stroke-width: 1.5;
  }
  .jig-label {
    fill: #e8bd68;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
  }
  .jig-mode {
    fill: rgba(232, 189, 104, 0.7);
    font-weight: 400;
    letter-spacing: 0;
  }
  .jig-foot {
    fill: rgba(207, 165, 86, 0.9);
    font-family: var(--font-mono);
    font-size: 8px;
  }

  .port {
    fill: rgba(28, 33, 40, 0.95);
    stroke: rgba(255, 255, 255, 0.3);
    stroke-width: 2;
  }
  .port-error {
    fill: rgba(28, 33, 40, 0.95);
    stroke: rgba(220, 80, 80, 0.5);
    stroke-width: 1.5;
  }

  .wire {
    fill: none;
    stroke: var(--border-1);
    stroke-width: 1.6;
  }
  .wire-hit {
    fill: none;
    stroke: transparent;
    stroke-width: 16;
    pointer-events: stroke;
    cursor: default;
  }
  .wire-tip {
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease;
  }
  .edge:hover .wire-tip {
    opacity: 1;
  }
  .edge:hover .wire {
    stroke: rgba(255, 255, 255, 0.8);
    stroke-dasharray: none;
  }
  .tip-bg {
    fill: var(--bg-3);
    stroke: var(--border-1);
    stroke-width: 1;
  }
  .wire-label {
    fill: var(--fg-0);
    font-family: var(--font-mono);
    font-size: 8px;
  }
  .origin-sourced .wire {
    stroke: color-mix(in srgb, var(--cat-source) 55%, var(--border-1));
  }
  .origin-generated .wire {
    stroke: color-mix(in srgb, var(--cat-synthesis) 70%, var(--border-1));
    stroke-dasharray: 4 4;
  }
  .origin-verified .wire {
    stroke: var(--success);
  }
  .origin-reviewed .wire {
    stroke: var(--cat-human);
  }

  /* one pass of execution state, left to right */
  .run .card-body,
  .run .pill-body {
    animation: step 1.1s ease forwards;
    animation-delay: calc(var(--i) * 0.55s + 0.6s);
  }
  .run .kind-gate .card-body {
    animation-name: gate;
  }
  .run .kind-egress .card-body {
    animation: none;
  }
  .wire-run {
    fill: none;
    stroke: #6aa681;
    stroke-width: 1.6;
    opacity: 0;
    animation: show 0.5s ease forwards;
    animation-delay: calc(var(--i) * 0.55s + 1.5s);
  }
  .run .card-state {
    animation: show 0.3s ease forwards;
    animation-delay: calc(var(--i) * 0.55s + 1.7s);
  }
  @keyframes step {
    0% {
      stroke: rgba(255, 255, 255, 0.12);
    }
    35% {
      stroke: rgba(176, 188, 204, 0.9);
      stroke-width: 1.5;
    }
    100% {
      stroke: #6aa681;
      stroke-width: 1;
    }
  }
  @keyframes gate {
    0% {
      stroke: rgba(255, 255, 255, 0.12);
    }
    35% {
      stroke: rgba(176, 188, 204, 0.9);
    }
    100% {
      stroke: var(--conf-needs-input);
    }
  }
  @keyframes show {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .run .card-body,
    .run .pill-body,
    .wire-run,
    .run .card-state {
      animation-duration: 0.001ms;
      animation-delay: 0s;
    }
  }

  figcaption {
    margin-top: var(--s-12);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-8) var(--s-20);
    font-size: var(--ms-small);
    color: var(--fg-2);
  }
  .legend {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--s-12);
    font-family: var(--font-mono);
    font-size: var(--fs-10);
    color: var(--fg-2);
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .key i {
    display: inline-block;
    width: 18px;
    height: 0;
    border-top: 1.5px solid var(--border-1);
  }
  .key.origin-sourced i {
    border-color: color-mix(in srgb, var(--cat-source) 55%, var(--border-1));
  }
