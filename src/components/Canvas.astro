---
import { kindCategory, extractionTint, originLabel } from "../lib/flow";
import type { CanvasFlow, CanvasNode } from "../lib/canvas";
import Status from "./Status.astro";

/**
 * A static drawing of a flow in the product's canvas grammar.
 *
 * The grammar is taken from the app (`web/src/style.css` on integration/f98):
 * a card is a 1px rgba(255,255,255,.12) border on rgba(28,33,40,.95) with an
 * 8px radius and a kind-coloured header; a Transform is a quiet grey pill; a
 * Jig is a translucent control region that holds its body; ports are 10px
 * rings on the card edge. Kind colours follow the decided map (D135,
 * F104.25). Wire origins (D139) are drawn as: Sourced and Computed plain,
 * Generated dashed, Verified and Reviewed tinted. Origin styling is a design
 * proposal, so a drawing that relies on it carries the "designed" status.
 *
 * `run` plays one pass of execution state left to right, once, and freezes
 * on the finished state under prefers-reduced-motion.
 */

interface Props {
  flow: CanvasFlow;
  caption?: string;
  status?: "built" | "designed";
  legend?: boolean;
  run?: boolean;
  width?: number;
}

const { flow, caption, status, legend = false, run = false, width: NW = 150 } = Astro.props;

const NH_CARD = 50;
const NH_PILL = 34;
const GAP_X = 40;
const PITCH_Y = 78;
const PAD = 18;
const JIG_PAD = 14;
const JIG_HEAD = 22;

function heightOf(n: CanvasNode) {
  return n.kind === "transform" ? NH_PILL : NH_CARD;
}

const maxCol = Math.max(...flow.nodes.map((n) => n.col));
const maxLane = Math.max(...flow.nodes.map((n) => n.lane));

type Placed = CanvasNode & { x: number; y: number; w: number; h: number; cx: number; cy: number };

const placed: Placed[] = flow.nodes
  .filter((n) => n.kind !== "jig")
  .map((n) => {
    const h = heightOf(n);
    const x = PAD + n.col * (NW + GAP_X);
    const y = PAD + JIG_HEAD + n.lane * PITCH_Y + (NH_CARD - h) / 2;
    return { ...n, x, y, w: NW, h, cx: x + NW / 2, cy: y + h / 2 };
  });

const byId = new Map(placed.map((p) => [p.id, p]));

const jigs = flow.nodes
  .filter((n) => n.kind === "jig")
  .map((j) => {
    const members = (j.body ?? []).map((id) => byId.get(id)!).filter(Boolean);
    const x0 = Math.min(...members.map((m) => m.x)) - JIG_PAD;
    const x1 = Math.max(...members.map((m) => m.x + m.w)) + JIG_PAD;
    const y0 = Math.min(...members.map((m) => m.y)) - JIG_PAD - JIG_HEAD;
    const y1 = Math.max(...members.map((m) => m.y + m.h)) + JIG_PAD;
    return { ...j, x: x0, y: y0, w: x1 - x0, h: y1 - y0 };
  });

const vw = PAD * 2 + (maxCol + 1) * NW + maxCol * GAP_X;
const vh = PAD * 2 + JIG_HEAD + maxLane * PITCH_Y + NH_CARD + 6;

const edges = flow.edges.map((e, i) => {
  const a = byId.get(e.from)!;
  const b = byId.get(e.to)!;
  const x1 = a.x + a.w + 5;
  const y1 = a.cy;
  const x2 = b.x - 5;
  const y2 = b.cy;
  const dx = Math.max(24, (x2 - x1) * 0.5);
  const d = `M ${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`;
  const mx = (x1 + x2) / 2;
  const my = (y1 + y2) / 2;
  const label = x2 - x1 >= 70 || Math.abs(y2 - y1) > 20 ? e.label : undefined;
  return { ...e, label, id: `${flow.id}-e${i}`, d, mx, my, origin: e.origin ?? "computed", col: a.col };
});

function tint(n: CanvasNode) {
  if (n.kind === "block" && n.extraction) return extractionTint;
  return kindCategory[n.kind];
}

const origins = Array.from(new Set(edges.map((e) => e.origin)));
const minWidth = Math.round(vw * 0.72);
---

<figure class:list={["canvas", { run }]} style={`--cols: ${maxCol + 1}; --min-w: ${minWidth}px`}>
  <div class="stage">
    <svg viewBox={`0 0 ${vw} ${vh}`} role="img" aria-label={flow.aria} preserveAspectRatio="xMidYMid meet">
      <defs>
        <pattern id={`grid-${flow.id}`} width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="1" class="grid-dot" />
        </pattern>
      </defs>
      <rect x="0" y="0" width={vw} height={vh} fill={`url(#grid-${flow.id})`} />

      {jigs.map((j) => (
        <g class="jig">
          <rect x={j.x} y={j.y} width={j.w} height={j.h} rx="10" class="jig-region" />
          <text x={j.x + 12} y={j.y + 15} class="jig-label">
            {j.verb.toUpperCase()}
            {j.mode && <tspan class="jig-mode"> {j.mode}</tspan>}
          </text>
        </g>
      ))}

      {edges.map((e) => (
        <g class={`edge origin-${e.origin}`} style={`--i: ${e.col}`}>
          <path d={e.d} class="wire" />
          {e.label && (
            <text x={e.mx} y={e.my - 7} text-anchor="middle" class="wire-label">
              {e.label}
            </text>
          )}
        </g>
      ))}

      {placed.map((n) =>
        n.kind === "transform" ? (
          <g class="node pill" style={`--tint: ${tint(n)}; --i: ${n.col}`}>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx={n.h / 2} class="pill-body" />
            <circle cx={n.x} cy={n.cy} r="5" class="port" />
            <circle cx={n.x + n.w} cy={n.cy} r="5" class="port" />
            <text x={n.x + 16} y={n.cy + (n.mode ? -1 : 4)} class="pill-verb">
              {n.verb}
            </text>
            {n.mode && (
              <text x={n.x + 16} y={n.cy + 11} class="pill-mode">
                {n.mode}
              </text>
            )}
          </g>
        ) : (
          <g class={`node card kind-${n.kind}`} style={`--tint: ${tint(n)}; --i: ${n.col}`}>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="8" class="card-body" />
            <path
              d={`M ${n.x} ${n.y + 8} a 8 8 0 0 1 8 -8 h ${n.w - 16} a 8 8 0 0 1 8 8 v 14 h ${-n.w} z`}
              class="card-head"
            />
            <text x={n.x + 9} y={n.y + 15} class="card-verb">
              {n.verb}
            </text>
            {n.mode && (
              <text x={n.x + n.w - 9} y={n.y + 15} text-anchor="end" class="card-badge">
                {n.mode}
              </text>
            )}
            <text x={n.x + 9} y={n.y + 38} class="card-title">
              {n.title ?? ""}
            </text>
            {run && n.kind === "gate" && (
              <text x={n.x + n.w - 9} y={n.y + 15} text-anchor="end" class="card-state">
                awaiting review
              </text>
            )}
            {n.kind !== "source" && <circle cx={n.x} cy={n.cy} r="5" class="port" />}
            {n.kind !== "egress" && <circle cx={n.x + n.w} cy={n.cy} r="5" class="port" />}
          </g>
        ),
      )}
    </svg>
  </div>
  {(caption || legend || status) && (
    <figcaption>
      <span class="left">
        {status && <Status status={status} />}
        {caption && <span class="cap">{caption}</span>}
      </span>
      {legend && (
        <span class="legend" aria-label="Wire origins">
          {origins.map((o) => (
            <span class={`key origin-${o}`}>
              <i aria-hidden="true" />
              {originLabel[o]}
            </span>
          ))}
        </span>
      )}
    </figcaption>
  )}
</figure>

<style>
  .canvas {
    margin: 0;
  }
  .stage {
    background: var(--bg-0);
    border: 1px solid var(--border-0);
    border-radius: var(--r-10);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .stage::-webkit-scrollbar {
    display: none;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  /* The canvas is a desktop object. On a phone it keeps a legible size and
     scrolls sideways instead of shrinking to a smear. */
  @media (max-width: 1100px) {
    svg {
      min-width: var(--min-w);
    }
  }
  .grid-dot {
    fill: rgba(230, 233, 238, 0.07);
  }

  /* cards: web/src/style.css .functionary-node */
  .card-body {
    fill: rgba(28, 33, 40, 0.97);
    stroke: rgba(255, 255, 255, 0.12);
    stroke-width: 1;
  }
  .card-head {
    fill: var(--tint);
    opacity: 0.92;
  }
  .card-verb {
    fill: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
  }
  .card-badge {
    fill: rgba(255, 255, 255, 0.78);
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .kind-gate .card-verb,
  .kind-gate .card-badge {
    fill: #1f1b0a;
  }
  .card-title {
    fill: #b8bec7;
    font-family: var(--font-ui);
    font-size: 10.5px;
  }
  .card-state {
    fill: #1f1b0a;
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    opacity: 0;
  }

  /* transforms: a quiet pill */
  .pill-body {
    fill: var(--bg-3);
    stroke: var(--border-1);
    stroke-width: 1;
  }
  .pill-verb {
    fill: var(--fg-0);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
  }
  .pill-mode {
    fill: var(--fg-2);
    font-family: var(--font-mono);
    font-size: 8px;
  }

  /* jigs: web/src/style.css .node-group-for-each */
  .jig-region {
    fill: rgba(217, 164, 65, 0.07);
    stroke: color-mix(in srgb, var(--cat-control) 65%, transparent);
    stroke-width: 1.5;
  }
  .jig-label {
    fill: #e8bd68;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
  }
  .jig-mode {
    fill: rgba(232, 189, 104, 0.7);
    font-weight: 400;
    letter-spacing: 0;
  }

  .port {
    fill: rgba(28, 33, 40, 0.95);
    stroke: rgba(255, 255, 255, 0.3);
    stroke-width: 2;
  }

  /* wires and the origin axis */
  .wire {
    fill: none;
    stroke: var(--border-1);
    stroke-width: 1.5;
  }
  .wire-label {
    fill: var(--fg-3);
    font-family: var(--font-mono);
    font-size: 7.5px;
  }
  .origin-sourced .wire {
    stroke: color-mix(in srgb, var(--cat-source) 55%, var(--border-1));
  }
  .origin-generated .wire {
    stroke: color-mix(in srgb, var(--cat-synthesis) 70%, var(--border-1));
    stroke-dasharray: 4 4;
  }
  .origin-verified .wire {
    stroke: var(--success);
  }
  .origin-reviewed .wire {
    stroke: var(--cat-human);
  }

  /* one pass of execution state, left to right; the product's running and
     completed treatments (exec-pulse, #6aa681 completed border). */
  .run .card-body,
  .run .pill-body {
    animation: step 1.1s ease forwards;
    animation-delay: calc(var(--i) * 0.55s + 0.6s);
  }
  .run .kind-gate .card-body {
    animation-name: gate;
  }
  .run .kind-egress .card-body {
    animation: none;
  }
  .run .card-state {
    animation: show 0.3s ease forwards;
    animation-delay: calc(var(--i) * 0.55s + 1.7s);
  }
  @keyframes step {
    0% {
      stroke: rgba(255, 255, 255, 0.12);
    }
    35% {
      stroke: rgba(176, 188, 204, 0.9);
      stroke-width: 1.5;
    }
    100% {
      stroke: #6aa681;
      stroke-width: 1;
    }
  }
  @keyframes gate {
    0% {
      stroke: rgba(255, 255, 255, 0.12);
    }
    35% {
      stroke: rgba(176, 188, 204, 0.9);
    }
    100% {
      stroke: var(--conf-needs-input);
    }
  }
  @keyframes show {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .run .card-body,
    .run .pill-body,
    .run .card-state {
      animation-duration: 0.001ms;
      animation-delay: 0s;
    }
  }

  figcaption {
    margin-top: var(--s-12);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-8) var(--s-20);
    font-size: var(--ms-small);
    color: var(--fg-2);
  }
  .left {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-8) var(--s-16);
  }
  .legend {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--s-12);
    font-family: var(--font-mono);
    font-size: var(--fs-10);
    color: var(--fg-2);
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .key i {
    display: inline-block;
    width: 18px;
    height: 0;
    border-top: 1.5px solid var(--border-1);
  }
  .key.origin-sourced i {
    border-color: color-mix(in srgb, var(--cat-source) 55%, var(--border-1));
  }
  .key.origin-generated i {
    border-top-style: dashed;
    border-color: color-mix(in srgb, var(--cat-synthesis) 70%, var(--border-1));
  }
  .key.origin-verified i {
    border-color: var(--success);
  }
  .key.origin-reviewed i {
    border-color: var(--cat-human);
  }
</style>
