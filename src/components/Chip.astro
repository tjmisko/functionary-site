---
type BlogType = "essay" | "usecase" | "note";

interface Props {
  /** Blog post-type chip. */
  type: BlogType;
}
const { type } = Astro.props;

const blogLabel: Record<BlogType, string> = {
  essay: "ESSAY",
  usecase: "USE CASE",
  note: "NOTE",
};
const blogVar: Record<BlogType, string> = {
  essay: "var(--accent-strong)",
  usecase: "var(--cat-transformation)",
  note: "var(--fg-2)",
};

const label = blogLabel[type];
const color = blogVar[type];
---

<span class="chip" style={`--chip: ${color}`}>{label}</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--fs-9);
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--chip);
    border: 1px solid color-mix(in srgb, var(--chip) 45%, transparent);
    background: color-mix(in srgb, var(--chip) 12%, transparent);
    padding: 2px 6px;
    border-radius: var(--r-3);
    line-height: 1.3;
    white-space: nowrap;
  }
</style>
