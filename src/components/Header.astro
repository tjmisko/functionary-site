---
import Button from "./Button.astro";

const nav = [
  { href: "/design", label: "Design" },
  { href: "/blog", label: "Blog" },
];

// Mark the active top-level section.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");

---

<header>
  <div class="container bar">
    <a href="/" class="wordmark-link" aria-label="Functionary home">
      <img class="mark" src="/logo.svg" alt="" aria-hidden="true" width="26" height="26" />
      <span class="wm">Functionary</span>
    </a>
    <nav aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={["navlink", { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <Button href="/download" variant="primary" size="sm">Download</Button>
  </div>
</header>

<style>
  /* Header scale: 1 on laptops and phones, growing in steps on big monitors so the bar keeps its proportion to the page. */
  header {
    --hs: 1;
  }
  @media (min-width: 1800px) {
    header {
      --hs: 1.25;
    }
  }
  @media (min-width: 2400px) {
    header {
      --hs: 1.6;
    }
  }
  @media (min-width: 3200px) {
    header {
      --hs: 2.1;
    }
  }
  @media (min-width: 4400px) {
    header {
      --hs: 2.8;
    }
  }
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border-0);
    background: color-mix(in srgb, var(--bg-1) 78%, transparent);
    backdrop-filter: blur(var(--blur-toolbar));
  }
  /* A full-bleed page sets --bar-w so the bar's ends line up with its canvas; elsewhere the bar keeps the reading width. */
  .bar.container {
    max-width: var(--bar-w, var(--container));
  }
  .bar {
    display: flex;
    align-items: center;
    gap: calc(var(--s-24) * var(--hs));
    height: calc(56px * var(--hs));
  }
  .wordmark-link {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--s-8) * var(--hs));
  }
  .wm {
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: calc(var(--fs-15) * var(--hs));
    color: var(--accent-strong);
  }
  .mark {
    display: block;
    width: calc(26px * var(--hs));
    height: calc(26px * var(--hs));
    flex-shrink: 0;
  }
  nav {
    display: flex;
    gap: calc(var(--s-20) * var(--hs));
    margin-right: auto;
  }
  .navlink {
    font-family: var(--font-mono);
    font-size: calc(var(--fs-12) * var(--hs));
    color: var(--fg-2);
    transition: color var(--t-medium);
  }
  .navlink:hover {
    color: var(--fg-0);
  }
  .navlink.active {
    color: var(--accent-strong);
  }
  header :global(.btn.sm) {
    font-size: calc(var(--fs-12) * var(--hs));
    padding: calc(0.4rem * var(--hs)) calc(0.8rem * var(--hs));
  }
  @media (max-width: 680px) {
    nav {
      display: none;
    }
    .bar {
      gap: var(--s-12);
    }
  }
</style>
